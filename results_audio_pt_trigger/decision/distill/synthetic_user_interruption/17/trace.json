, {"kind": "partial", "text": "bom que esteja", "t_start": 13.020000000000001, "t_end": 13.66, "t_avail": 14.4, "ends_turn": false, "utt": 2}, {"kind": "silence", "text": "<|no voice|>", "t_start": 14.8, "t_end": 14.8, "t_avail": 14.8, "ends_turn": false, "utt": 0}, {"kind": "final", "text": "em cartaz?", "t_start": 13.66, "t_end": 14.200000000000001, "t_avail": 15.0, "ends_turn": true, "utt": 2}, {"kind": "silence", "text": "<|no voice|>", "t_start": 15.600000000000001, "t_end": 15.600000000000001, "t_avail": 15.600000000000001, "ends_turn": false, "utt": 0}, {"kind": "silence", "text": "<|no voice|>", "t_start": 16.2, "t_end": 16.2, "t_avail": 16.2, "ends_turn": false, "utt": 0}, {"kind": "silence", "text": "<|no voice|>", "t_start": 16.8, "t_end": 16.8, "t_avail": 16.8, "ends_turn": false, "utt": 0}, {"kind": "silence", "text": "<|no voice|>", "t_start": 17.400000000000002, "t_end": 17.400000000000002, "t_avail": 17.400000000000002, "ends_turn": false, "utt": 0}, {"kind": "silence", "text": "<|no voice|>", "t_start": 18.0, "t_end": 18.0, "t_avail": 18.0, "ends_turn": false, "utt": 0}, {"kind": "silence", "text": "<|no voice|>", "t_start": 18.6, "t_end": 18.6, "t_avail": 18.6, "ends_turn": false, "utt": 0}, {"kind": "silence", "text": "<|no voice|>", "t_start": 19.200000000000003, "t_end": 19.200000000000003, "t_avail": 19.200000000000003, "ends_turn": false, "utt": 0}, {"kind": "silence", "text": "<|no voice|>", "t_start": 19.8, "t_end": 19.8, "t_avail": 19.8, "ends_turn": false, "utt": 0}, {"kind": "silence", "text": "<|no voice|>", "t_start": 20.400000000000002, "t_end": 20.400000000000002, "t_avail": 20.400000000000002, "ends_turn": false, "utt": 0}, {"kind": "silence", "text": "<|no voice|>", "t_start": 21.0, "t_end": 21.0, "t_avail": 21.0, "ends_turn": false, "utt": 0}, {"kind": "silence", "text": "<|no voice|>", "t_start": 21.6, "t_end": 21.6, "t_avail": 21.6, "ends_turn": false, "utt": 0}], "user_speech_spans": [[0.3, 2.0], [10.6, 11.6], [12.4, 14.3]], "decisions": [{"kind": "final", "t": 2.6, "piece": "Tal vai ficar o tempo esse fim", "ends_turn": false, "tag": "user_is_speaking", "text": "**1.**  \n*Wel, tal vai ficar o tempo esse fim?*  \n**2.**", "compute_s": 0.362}, {"kind": "final", "t": 2.6, "piece": "de semana", "ends_turn": true, "tag": "user_is_speaking", "text": "**3.**  \n*De semana... pode ser que fique bom.*  \n**4.**", "compute_s": 0.143}, {"kind": "silence", "t": 3.2, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "**5.**  \n*Fica mais claro, né?*  \n**6.**", "compute_s": 0.128}, {"kind": "silence", "t": 3.8, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "**7.**  \n*O tempo deixa espaço pra pensar...*  \n**8.**", "compute_s": 0.143}, {"kind": "silence", "t": 4.4, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "**9.**  \n*E a gente espera o que vem.*  \n**10.**", "compute_s": 0.137}, {"kind": "silence", "t": 5.0, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "**11.**  \n*Silêncio é sinal de esperança também...*  \n**12", "compute_s": 0.155}, {"kind": "silence", "t": 5.6, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "**13.**  \n*O tempo não fala, mas escuta.*  \n**14.**", "compute_s": 0.157}, {"kind": "silence", "t": 6.2, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "**15.**  \n*E aí? Você quer saber o que vai acontecer... ou só quer sentir", "compute_s": 0.157}, {"kind": "silence", "t": 6.8, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "**16.**  \n*Ouvir é mais do que prever.*  \n**17.**", "compute_s": 0.158}, {"kind": "silence", "t": 7.4, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "**18.**  \n*E se eu não disser nada?*  \n**19.**", "compute_s": 0.151}, {"kind": "silence", "t": 8.0, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "**20.**  \n*O silêncio tem voz também...*  \n**21.**", "compute_s": 0.155}, {"kind": "silence", "t": 8.6, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "**22.**  \n*E se o tempo não disser nada?*  \n**23.**", "compute_s": 0.163}, {"kind": "silence", "t": 9.2, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "**24.**  \n*O que importa é como você responde...*  \n**25.**", "compute_s": 0.158}, {"kind": "silence", "t": 9.8, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "**26.**  \n*E se o silêncio fosse a resposta?*  \n**27", "compute_s": 0.158}, {"kind": "silence", "t": 12.0, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "**28.**  \n*Ouvir não é escutar... é sentir.*  \n**29.**", "compute_s": 0.16}, {"kind": "partial", "t": 12.0, "piece": "A gente fala de outra", "ends_turn": false, "tag": "user_is_speaking", "text": "**30.**  \n*A gente fala de outra coisa, né?*  \n**31.**", "compute_s": 0.161}, {"kind": "final", "t": 12.2, "piece": "coisa", "ends_turn": true, "tag": "user_is_speaking", "text": "**32.**  \n*Coisa que não precisa ser dita...*  \n**33.**", "compute_s": 0.158}, {"kind": "partial", "t": 13.6, "piece": "Tá algum filme", "ends_turn": false, "tag": "user_is_speaking", "text": "**34.**  \n*Tá um filme? Que filme?*  \n**35.**", "compute_s": 0.146}, {"kind": "partial", "t": 14.4, "piece": "bom que esteja", "ends_turn": false, "tag": "user_is_speaking", "text": "**36.**  \n*Bom que esteja... bom pra quem tá aqui.*  \n**37.**", "compute_s": 0.162}, {"kind": "silence", "t": 14.8, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "**38.**  \n*E se o filme já estivesse começando?*  \n**39.", "compute_s": 0.161}, {"kind": "final", "t": 15.0, "piece": "em cartaz?", "ends_turn": true, "tag": "user_is_speaking", "text": "**40.**  \n*Em cartaz... ou só na cabeça do mundo?*  \n**41.", "compute_s": 0.16}, {"kind": "silence", "t": 15.6, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "**42.**  \n*O que está em cartaz, talvez já esteja no seu olhar.*", "compute_s": 0.16}, {"kind": "silence", "t": 16.2, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "**43.**  \n*E se o filme não tivesse roteiro... só você e a som", "compute_s": 0.16}, {"kind": "silence", "t": 16.8, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "**44.**  \n*O que é real, quando ninguém diz?*  \n**45.**", "compute_s": 0.161}, {"kind": "silence", "t": 17.4, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "**46.**  \n*E se o silêncio fosse o primeiro ator?*  \n**", "compute_s": 0.159}, {"kind": "silence", "t": 18.0, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "**47.**  \n*O mundo não precisa de som pra contar a história...*  \n**48.", "compute_s": 0.16}, {"kind": "silence", "t": 18.6, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "**49.**  \n*E se a história já estivesse dentro do seu silêncio?*", "compute_s": 0.164}, {"kind": "silence", "t": 19.2, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "**50.**  \n*O que é verdade, quando ninguém fala... pode ser o que você sente", "compute_s": 0.161}, {"kind": "silence", "t": 19.8, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "**51.**  \n*E se o tempo não tivesse fim... só começasse em silênc", "compute_s": 0.162}, {"kind": "silence", "t": 20.4, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "**52.**  \n*O começo é o que fica quando tudo para.*", "compute_s": 0.132}, {"kind": "silence", "t": 21.0, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "**53.**  \n*E se o silêncio fosse a primeira palavra?*", "compute_s": 0.151}, {"kind": "silence", "t": 21.6, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "**54.**  \n*Sem palavras, só presença... e isso já é história.*", "compute_s": 0.143}], "render": {"placed_speech_s": 0, "placed_within_input_s": 0, "speech_beyond_input_s": 0, "clipped_speech_s": 0, "tail_s": 4.0, "turns": 0}}