 {"kind": "silence", "text": "<|no voice|>", "t_start": 26.200000000000003, "t_end": 26.200000000000003, "t_avail": 26.200000000000003, "ends_turn": false, "utt": 0}, {"kind": "final", "text": "PEN -", "t_start": 25.400000000000002, "t_end": 25.820000000000004, "t_avail": 26.400000000000002, "ends_turn": true, "utt": 6}, {"kind": "partial", "text": "Outras pessoas brancas que", "t_start": 26.51, "t_end": 27.990000000000002, "t_avail": 28.6, "ends_turn": false, "utt": 7}, {"kind": "partial", "text": "cometeram os", "t_start": 27.990000000000002, "t_end": 28.55, "t_avail": 29.200000000000003, "ends_turn": false, "utt": 7}, {"kind": "partial", "text": "mesmos crimes em", "t_start": 28.55, "t_end": 29.310000000000002, "t_avail": 30.0, "ends_turn": false, "utt": 7}, {"kind": "partial", "text": "múltiplos", "t_start": 29.270000000000003, "t_end": 29.790000000000003, "t_avail": 30.6, "ends_turn": false, "utt": 7}, {"kind": "final", "text": "estados. Mas isso não é verdade.", "t_start": 29.790000000000003, "t_end": 30.970000000000002, "t_avail": 31.0, "ends_turn": true, "utt": 7}, {"kind": "partial", "text": "significa", "t_start": 31.0, "t_end": 31.56, "t_avail": 32.2, "ends_turn": false, "utt": 8}, {"kind": "partial", "text": "que devamos", "t_start": 31.5, "t_end": 32.18, "t_avail": 32.800000000000004, "ends_turn": false, "utt": 8}, {"kind": "partial", "text": "ou não ter", "t_start": 32.18, "t_end": 32.66, "t_avail": 33.6, "ends_turn": false, "utt": 8}, {"kind": "silence", "text": "<|no voice|>", "t_start": 34.0, "t_end": 34.0, "t_avail": 34.0, "ends_turn": false, "utt": 0}, {"kind": "final", "text": "a pena de morte.", "t_start": 32.66, "t_end": 33.4, "t_avail": 34.2, "ends_turn": true, "utt": 8}, {"kind": "partial", "text": "Talvez isso", "t_start": 34.2, "t_end": 34.88, "t_avail": 35.6, "ends_turn": false, "utt": 9}, {"kind": "partial", "text": "seja um argumento", "t_start": 34.900000000000006, "t_end": 35.660000000000004, "t_avail": 36.2, "ends_turn": false, "utt":