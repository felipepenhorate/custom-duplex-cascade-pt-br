# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
unsloth_compiled_cache/

# Trained model runs (large; live on the HDD /mnt/f by default)
/mnt/f/duplex_cascade_runs/
**/training/runs/
*.gguf
*.safetensors

# Large generated datasets (rebuilt via the data pipeline)
**/data/*.jsonl
**/data/prepped_*/
**/data/__pycache__/

# Full-Duplex-Bench run outputs.
#
# results/ IS committed: it is the evidence behind every table in
# fdb_bench/FINDINGS.md and distill/article/main.tex, and it is small once the
# two things below are excluded. Kept:
#   <lang>/<model>/{raw,judged,quality}.jsonl, meta.json, judge_meta.json,
#                  summary.md, summary.json, inference.log, judge.log
#   <lang>/{summary.md,summary.json}, comparison.md
# Excluded because they are pure noise or duplicates:
results/**/llama-server.log
results/**/judge-server.log
results/**/*.jsonl.bak
# The superseded run kept for the turn-length bug write-up, not a result.
results_longturns_buggy/

# Audio Full-Duplex-Bench outputs (fdb_bench/audio/README.md).
#
# results_audio/ IS committed: it holds the rendered audio, the parakeet
# transcripts, the session traces and the benchmark's own metric outputs -- the
# evidence behind the audio tables. Server logs and the judge's raw replies are
# noise, and the llama.cpp servers are re-runnable from the committed config.
results_audio/**/llama-server.log
results_audio/**/judge-server.log
results_audio/**/*.log.bak

# Runtime logs
**/logs/*.log
**/logs/*.err
**/logs/*_foreground.log
**/logs/eval/

# LaTeX build artifacts
**/article/*.aux
**/article/*.log

# Editor / OS
.vscode/
.idea/
.DS_Store

# CUDA / misc
core.*
