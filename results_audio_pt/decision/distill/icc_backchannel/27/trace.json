text": "E aí eu", "t_start": 35.0, "t_end": 35.9, "t_avail": 36.800000000000004, "ends_turn": false, "utt": 12}, {"kind": "silence", "text": "<|no voice|>", "t_start": 37.2, "t_end": 37.2, "t_avail": 37.2, "ends_turn": false, "utt": 0}, {"kind": "final", "text": "só era tipo...", "t_start": 35.88, "t_end": 36.98, "t_avail": 37.4, "ends_turn": true, "utt": 12}, {"kind": "silence", "text": "<|no voice|>", "t_start": 38.0, "t_end": 38.0, "t_avail": 38.0, "ends_turn": false, "utt": 0}, {"kind": "silence", "text": "<|no voice|>", "t_start": 38.6, "t_end": 38.6, "t_avail": 38.6, "ends_turn": false, "utt": 0}, {"kind": "partial", "text": "Ok, aí eu", "t_start": 39.19, "t_end": 39.79, "t_avail": 40.400000000000006, "ends_turn": false, "utt": 13}, {"kind": "partial", "text": "faço", "t_start": 39.81, "t_end": 39.989999999999995, "t_avail": 41.2, "ends_turn": false, "utt": 13}, {"kind": "partial", "text": "e eu era tipo", "t_start": 40.01, "t_end": 40.55, "t_avail": 41.800000000000004, "ends_turn": false, "utt": 13}, {"kind": "final", "text": "uau, isso é tão divertido.", "t_start": 40.71, "t_end": 41.87, "t_avail": 42.400000000000006, "ends_turn": true, "utt": 13}, {"kind": "partial", "text": "Eu estava só muito", "t_start": 42.400000000000006, "t_end": 43.10000000000001, "t_avail": 43.800000000000004, "ends_turn": false, "utt": 14}, {"kind": "final", "text": "assustada, e ela era só...", "t_start": 43.10000000000001, "t_end": 44.38, "t_avail": 44.400000000000006, "ends_turn": true, "utt": 14}, {"kind": "partial", "text": "Eu não quero", "t_start": 44.400000000000006, "t_end": 45.14000000000001, "t_avail": 45.800000000000004, "ends_turn": false, "utt": 15}, {"kind": "silence", "text": "<|no voice|>", "t_start": 46.6, "t_end": 46.6, "t_avail": 46.6, "ends_turn": false, "utt": 0}, {"kind": "final", "text": "quero. Sei se eles amam.", "t_start": 44.940000000000005, "t_end": 46.02, "t_avail": 46.800000000000004, "ends_turn": true, "utt": 15}, {"kind": "partial", "text": "por cau