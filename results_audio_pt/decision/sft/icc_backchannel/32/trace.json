eech", "n_words": 16, "stopped": false}], "user_pieces": [{"kind": "partial", "text": "Isso é bom, você já viu ele", "t_start": 1.84, "t_end": 3.5, "t_avail": 5.2, "ends_turn": false, "utt": 0}, {"kind": "partial", "text": "fazendo isso em hospitais", "t_start": 3.5, "t_end": 4.44, "t_avail": 5.2, "ends_turn": false, "utt": 0}, {"kind": "partial", "text": "com aquele fio.", "t_start": 4.44, "t_end": 5.24, "t_avail": 5.800000000000001, "ends_turn": false, "utt": 0}, {"kind": "final", "text": "fio. Enfim, tipo...", "t_start": 4.84, "t_end": 6.38, "t_avail": 6.4, "ends_turn": true, "utt": 0}, {"kind": "final", "text": "Então vamos ao seu PUM!", "t_start": 6.4, "t_end": 7.54, "t_avail": 7.6000000000000005, "ends_turn": true, "utt": 1}, {"kind": "silence", "text": "<|no voice|>", "t_start": 8.200000000000001, "t_end": 8.200000000000001, "t_avail": 8.200000000000001, "ends_turn": false, "utt": 0}, {"kind": "final", "text": "Pô. Da -", "t_start": 7.98, "t_end": 8.38, "t_avail": 8.4, "ends_turn": true, "utt": 2}, {"kind": "partial", "text": "até o anel bem", "t_start": 8.4, "t_end": 9.16, "t_avail": 10.0, "ends_turn": false, "utt": 3}, {"kind": "partial", "text": "apertado com aquele", "t_start": 9.14, "t_end": 10.0, "t_avail": 10.600000000000001, "ends_turn": false, "utt": 3}, {"kind": "partial", "text": "fio bem", "t_start": 10.0, "t_end": 10.66, "t_avail": 11.4, "ends_turn": false, "utt": 3}, {"kind": "final", "text": "fino.", "t_start": 10.66, "t_end": 10.9, "t_avail": 11.600000000000001, "ends_turn": true, "utt": 3}, {"kind": "final", "text": "foi uma vez", "t_start": 11.600000000000001, "t_end": 12.580000000000002, "t_avail": 12.600000000000001, "ends_turn": true, "utt": 4}, {"kind": "partial", "text": "vez que", "t_start": 12.600000000000001, "t_end": 13.080000000000002, "t_avail": 14.200000000000001, "ends_turn": false, "utt": 5}, {"kind": "final", "text": "que chegam no anel, eles colocam aquela", "t_start": 12.780000000000001, "t_end": 14.920000000000002, "t_avail