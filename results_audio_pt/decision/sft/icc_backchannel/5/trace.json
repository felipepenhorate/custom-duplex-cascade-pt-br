_turn": false, "utt": 1}, {"kind": "partial", "text": "é tipo", "t_start": 7.140000000000001, "t_end": 7.5200000000000005, "t_avail": 8.6, "ends_turn": false, "utt": 1}, {"kind": "partial", "text": "em", "t_start": 7.5200000000000005, "t_end": 7.680000000000001, "t_avail": 9.200000000000001, "ends_turn": false, "utt": 1}, {"kind": "silence", "text": "<|no voice|>", "t_start": 10.600000000000001, "t_end": 10.600000000000001, "t_avail": 10.600000000000001, "ends_turn": false, "utt": 0}, {"kind": "partial", "text": "hortes eu saí de primeiro para. Mas", "t_start": 7.98, "t_end": 9.68, "t_avail": 10.600000000000001, "ends_turn": false, "utt": 1}, {"kind": "final", "text": "Mas também...", "t_start": 9.440000000000001, "t_end": 10.3, "t_avail": 10.8, "ends_turn": true, "utt": 1}, {"kind": "partial", "text": "Eu que vi uma", "t_start": 10.8, "t_end": 11.58, "t_avail": 12.4, "ends_turn": false, "utt": 2}, {"kind": "partial", "text": "oportunidade", "t_start": 11.58, "t_end": 12.16, "t_avail": 13.200000000000001, "ends_turn": false, "utt": 2}, {"kind": "partial", "text": "de tipo, não pegar matemática.", "t_start": 12.16, "t_end": 13.420000000000002, "t_avail": 14.0, "ends_turn": false, "utt": 2}, {"kind": "partial", "text": "então eu só não. Tô pegando", "t_start": 13.620000000000001, "t_end": 14.72, "t_avail": 15.4, "ends_turn": false, "utt": 2}, {"kind": "partial", "text": "matemática de jeito", "t_start": 14.72, "t_end": 15.56, "t_avail": 16.2, "ends_turn": false, "utt": 2}, {"kind": "partial", "text": "nenhum, mas", "t_start": 15.56, "t_end": 16.240000000000002, "t_avail": 16.8, "ends_turn": false, "utt": 2}, {"kind": "partial", "text": "eu sinto que", "t_start": 16.26, "t_end": 16.86, "t_avail": 17.400000000000002, "ends_turn": false, "utt": 2}, {"kind": "partial", "text": "provavelmente", "t_start": 16.92, "t_end": 17.32, "t_avail": 18.2, "ends_turn": false, "utt": 2}, {"kind": "final", "text": "deveria.", "t_start": 17.32, "t_end": 17.880000000000003, "t_avail": 18.400000000000002, "ends_turn": true, "utt": 2}, {"kind": "silence", "text": "<|no voice|>", "t_start": 19.200000000000003, "t_end": 19.200000000000003, "t_avail": 19.200000000000003, "ends_turn": false, "utt": 0}, {"kind": "final", "text": "que tudo.", "t_start": 18.400000000000002, "t_end": 18.660000000000004, "t_avail": 19.400000000000002, "ends_turn": true, "utt": 3}, {"kind": "partial", "text": "Eu não sei, eu sinto que", "t_start": 19.67, "t_end": 20.950000000000003, "t_avail": 21.6, "ends_turn": false, "utt": 4}, {"kind": "partial", "text": "ajudar pode ser", "t_start": 20.950000000000003, "t_end": 21.69, "t_avail": 22.200000000000003, "ends_turn": false, "utt": 4}, {"kind": "partial", "text": "útil.", "t_start": 21.71, "t_end": 22.05, "t_avail": 23.0, "ends_turn": false, "utt": 4}, {"kind": "final", "text": "ÚTIL. Eu sinto que ajudar pode ser", "t_start": 22.39, "t_end": 23.37, "t_avail": 23.400000000000002, "ends_turn": false, "utt": 4}, {"kind": "final", "text": "útil.", "t_start": 23.37, "t_end": 23.37, "t_avail": 23.400000000000002, "ends_turn": true, "utt": 4}, {"kind": "partial", "text": "que", "t_start": 23.400000000000002, "t_end": 23.700000000000003, "t_avail": 25.0, "ends_turn": false, "utt": 5}, {"kind": "final", "text": "a gente quer assustar o mundo.", "t_start": 23.680000000000003, "t_end": 25.060000000000002, "t_avail": 25.6, "ends_turn": true, "utt": 5}, {"kind": "final", "text": "era tipo... coisas em...", "t_start": 25.6, "t_end": 27.18, "t_avail": 27.200000000000003, "ends_turn": true, "utt": 6}, {"kind": "partial", "text": "interessante, exceto", "t_start": 27.200000000000003, "t_end": 28.320000000000004, "t_avail": 29.200000000000003, "ends_turn": false, "utt": 7}, {"kind": "partial", "text": "tipo séries", "t_start": 28.320000000000004, "t_end": 29.020000000000003, "t_avail": 30.0, "ends_turn": false, "utt": 7}, {"kind": "silence", "text": "<|no voice|>", "t_start": 31.200000000000003, "t_end": 31.200000000000003, "t_avail": 31.2000000000