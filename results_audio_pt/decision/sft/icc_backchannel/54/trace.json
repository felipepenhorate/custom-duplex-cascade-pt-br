"asr_settle_s": 0.0}, {"speech_onset": 50.5, "stop_at": 50.735, "reaction_s": 0.138, "flush_before_playback": true}, {"speech_onset": 54.9, "stop_at": 55.132, "reaction_s": 0.232, "played_before_stop_s": 1.345, "would_have_played_s": 2.32, "asr_settle_s": 0.3}, {"speech_onset": 56.9, "stop_at": 57.265, "reaction_s": 0.365, "played_before_stop_s": 0.539, "would_have_played_s": 4.0, "asr_settle_s": 0.3}, {"speech_onset": 64.1, "stop_at": 64.396, "reaction_s": 0.296, "flush_before_playback": true}], "utt_finalized": 22, "utt_skipped": {"too_short": 1}, "audio_beyond_input_s": 3.6, "tts_capped": 0, "tts_capped_words": 0, "paused_floor_take": null, "interrupt_span": null, "post_interrupt_text": "", "took_floor_after_interrupt": false, "tags": ["user_is_speaking:empty", "user_finish_speaking", "user_is_speaking:empty", "user_is_speaking:empty", "user_finish_speaking", "user_is_thinking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_finish_speaking", "user_finish_speaking", "user_is_thinking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_finish_speaking", "user_interruption:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_finish_speaking", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_finish_speaking", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_finish_speaking", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_finish_speaking", "user_is_speaking:empty", "user_is_speaking:empty", "user_finish_speaking", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_finish_speaking", "user_is_speaking:empty", "user_is_speaking:empty", "user_finish_speaking", "user_is_speaking:empty", "user_is_speaking:empty", "user_finish_speaking", "user_finish_speaking", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_finish_speaking", "user_is_thinking:empty", "user_is_speaking:empty", "user_finish_speaking"], "turns": [{"start": 6.031, "end": 6.63, "natural_end": 10.831, "dur": 0.599, "text": "É um debate, né? Às vezes, a gente precisa ouvir o lado do outro para ver a dimensão do problema.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 20, "stopped": true}, {"start": 9.737, "end": 9.921, "natural_end": 12.537, "dur": 0.185, "text": "Exatamente! É assim que a gente aprende, né?", "tag": "user_finish_speaking", "kind": "speech", "n_words": 8, "stopped": true}, {"start": 15.467, "end": 16.429, "natural_end": 21.307, "dur": 0.961, "text": "Haha, esses nomes são demais! É bom lembrar que a polêmica é sempre mais interessante quando tem um toque de humor.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 21, "stopped": true}, {"start": 16.729, "end": 18.723, "natural_end": 18.889, "dur": 1.995, "text": "É isso aí! O debate rende muito!", "tag": "user_finish_speaking", "kind": "speech", "n_words": 7, "stopped": true}, {"start": 24.955, "end": 25.424, "natural_end": 28.635, "dur": 0.468, "text": "Entendo essa sensação de isolamento. É um peso emocional grande.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 10, "stopped": true}, {"start": 29.242, "end": 30.126, "natural_end": 34.922, "dur": 0.885, "text": "Ah, as diferenças locais são gigantescas! É um fator que sempre complica a visão geral do país.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 17, "stopped": true}, {"start": 34.604, "end": 38.524, "natural_end": 38.524, "dur": 3.92, "text": "Mudou mesmo! O que te faz mudar de ideia é sempre um fator social .", "tag": "user_finish_speaking", "kind": "speech", "n_words": 15, "stopped": false}, {"start": 38.524, "end": 38.823, "natural_end": 41.884, "dur": 0.299, "text": "É isso! É assim que a gente evolui.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 8, "stopped": true}, {"start": 44.554, "end": 48.474, "natural_end": 48.474, "dur": 3.92, "text": "Faz sentido! O perfil do estado influencia muito na cultura política.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 11, "stopped": false}, {"start": 48.789, "end": 49.483, "natural_end": 52.229, "dur": 0.694, "text": "Não é um \"tipo\" único, é um esquema de interação constante.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 11, "stopped": true}, {"start": 50.735, "end": 50.735, "natural_end": 52.975, "dur": 0.0, "text": "Tchau! Bora trocar mais tarde!", "tag": "user_finish_speaking", "kind": "speech", "n_words": 5, "stopped": true}, {"start": 53.555, "end": 55.132, "natural_end": 55.875, "dur": 1.577, "text": "É um tema que sempre gera muita discussão, vi u?", "tag": "user_finish_speaking", "kind": "speech", "n_words": 10, "stopped": true}, {"start": 56.361, "end": 57.265, "natural_end": 60.361, "dur": 0.904, "text": "É sobre a complexidade da realidade, não sobre um único lado.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 11, "stopped": true}, {"start": 57.565, "end": 60.045, "natural_end": 60.045, "dur": 2.48, "text": "Exatamente! É sobre a nuance, não sobre o passado.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 9, "stopped": false}, {"start": 64.286, "end": 64.396, "natural_end": 68.286, "dur": 0.11, "text": "Esses custos são bem altos, realmente. É um fator decisivo para a escolha de cursos.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 15, "stopped": true}, {"start": 66.609, "end": 70.209, "natural_end": 70.209, "dur": 3.6, "text": "Principalmente na infraestrutura de apoio e na disponibilidade de bolsas.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 10, "stopped": false}], "user_pieces": [{"kind": "partial", "text": "Sim,", "t_start": 1.71, "t_end": 2.41, "t_avail": 5.2, "ends_turn": false, "utt": 0}, {"kind": "partial", "text": "concordo. Não poderia concordar mais.", "t_start": 2.49, "t_end": 5.08, "t_avail": 5.800000000000001, "ends_turn": false, "utt": 0}, {"kind": "final", "text": "isso.", "t_start": 5.5, "t_end": 5.94, "t_avail": 7.0, "ends_turn": true, "utt": 0}, {"kind": "silence", "text": "<|no voice|>", "t_start": 9.600000000000001, "t_end": 9.600000000000001, "t_avail": 9.600000000000001, "ends_turn": false, "utt": 0}, {"kind": "partial", "text": "que justamente tipo abriu meus olhos.", "t_start": 7.0, "t_end": 8.7, "t_avail": 9.600000000000001, "ends_turn": false, "utt": 1}, {"kind": "final", "text": "", "t_start": 9.8, "t_end": 9.8, "t_avail": 9.8, "ends_turn": true, "utt": 1}, {"kind": "partial", "text": "o estado", "t_start": 9.8, "t_end": 10.56, "t_avail": 11.4, "ends_turn": false, "utt": 2}, {"kind": "partial", "text": "tipo do país", "t_start": 10.540000000000001, "t_end": 11.260000000000002, "t_avail": 12.200000000000001, "ends_turn": false, "utt": 2}, {"kind": "partial", "text": "tipo tipo tipo", "t_start": 11.260000000000002, "t_end": 12.120000000000001, "t_avail": 13.0, "ends_turn": false, "utt": 2}, {"kind": "partial", "text": "Tiboru H", "t_start": 12.120000000000001, "t_end": 12.940000000000001, "t_avail": 13.600000000000001, "ends_turn": false, "utt": 2}, {"kind": "silence", "text": "<|no voice|>", "t_start": 13.8, "t_end": 13.8, "t_avail": 13.8, "ends_turn": false, "utt": 0}, {"kind": "final", "text": "foi", "t_start": 12.96, "t_end": 13.16, "t_avail": 14.0, "ends_turn": true, "utt": 2}, {"kind": "final", "text": "e tchupu. Plush!", "t_start": 14.0, "t_end": 15.18, "t_avail": 15.200000000000001, "ends_turn": true, "utt": 3}, {"kind": "partial", "text": "choque tão grande.", "t_start": 15.200000000000001, "t_end": 16.1, "t_avail": 16.6, "ends_turn": false, "utt": 4}, {"kind": "final", "text": "", "t_start": 16.8, "t_end": 16.8, "t_avail": 16.8, "ends_turn": true, "utt": 4}, {"kind": "partial", "text": "Eu sempre senti", "t_start": 16.8, "t_end": 18.0, "t_avail": 18.8, "ends_turn": false, "utt": 5}, {"kind": "final", "text": "tipo...", "t_start": 18.64, "t_end": 18.86, "t_avail": 19.0, "ends_turn": true, "utt": 5}, {"kind": "silence", "text": "<|no voice|>", "t_start": 19.6, "t_end": 19.6, "t_avail": 19.6, "ends_turn": false, "utt": 0}, {"kind": "final", "text": "", "t_start": 19.8, "t_end": 19.8, "t_avail": 19.8, "ends_turn": true, "utt": 6}, {"kind": "silence", "text": "<|no voice|>", "t_start": 20.8, "t_end": 20.8, "t_avail": 20.8, "ends_turn": false, "utt": 0}, {"kind": "final", "text": "Que o...", "t_start": 19.8, "t_end": 20.68, "t_avail": 21.0, "ends_turn": true, "utt": 7}, {"kind": "partial", "text": "tipo o resto do país tava tipo", "t_start": 21.0, "t_end": 22.42, "t_avail": 23.6, "ends_turn": false, "utt": 8}, {"kind": "partial", "text": "numa bolha", "t_start": 22.42, "t_end": 23.02, "t_avail": 23.6, "ends_turn": false, "utt": 8}, {"kind": "final", "text": "e eu era tipo", "t_start": 23.04, "t_end": 23.78, "t_avail": 23.8, "ends_turn": true, "utt": 8}, {"kind": "silence", "text": "<|no voice|>", "t_start": 24.6, "t_end": 24.6, "t_avail": 24.6, "ends_turn": false, "utt": 0}, {"kind": "final", "text": "Pô.", "t_start": 23.8, "t_end": 24.04, "t_avail": 24.8, "ends_turn": true, "utt": 9}, {"kind": "partial", "text": "Tipo, eu morava", "t_start": 25.560000000000002, "t_end": 26.3, "t_avail": 27.0, "ends_turn": false, "utt": 10}, {"kind": "partial", "text": "numa comunidade", "t_start": 26.3, "t_end": 26.94, "t_avail": 27.6, "ends_turn": false, "utt": 10}, {"kind": "partial", "text": "tão", "t_start": 26.94, "t_end": 27.14, "t_avail": 28.200000000000003, "ends_turn": false, "utt": 10}, {"kind": "final", "text": "diversa que é tipo, é tipo a", "t_start": 27.14, "t_end": 28.98, "t_avail": 29.0, "ends_turn": false, "utt": 10}, {"kind": "final", "text": "merda.", "t_start": 28.98, "t_end": 28.98, "t_avail": 29.0, "ends_turn": true, "utt": 10}, {"kind": "final", "text": "A América é ótimo, mas...", "t_start": 29.0, "t_end": 30.44, "t_avail": 30.6, "ends_turn": true, "utt": 11}, {"kind": "partial", "text": "quando vim pra cá,", "t_start": 30.6, "t_end": 31.32, "t_avail": 32.0, "ends_turn": false, "utt": 12}, {"kind": "partial", "text": "percebi que era quem", "t_start": 31.48, "t_end": 32.06, "t_avail": 32.6, "ends_turn": false, "utt": 12}, {"kind": "partial", "text": "tava", "t_start": 32.06, "t_end": 32.300000000000004, "t_avail": 33.2, "ends_turn": false, "utt": 12}, {"kind": "partial", "text": "morando", "t_start": 32.300000000000004, "t_end": 32.92, "t_avail": 33.800000000000004, "ends_turn": false, "utt": 12}, {"kind": "final", "text": "morando na bolê. Pô, isso mudou tudo.", "t_start": 32.300000000000004, "t_end": 34.38, "t_avail": 34.4, "ends_turn": true, "utt": 12}, {"kind": "partial", "text": "totalmente", "t_start": 34.4, "t_end": 34.9, "t_avail": 35.6, "ends_turn": false, "utt": 13}, {"kind": "partial", "text": "tipo minha", "t_start": 34.9, "t_end": 35.4, "t_avail": 36.2, "ends_turn": false, "utt": 13}, {"kind": "partial", "text": "perspectiva de", "t_start": 35.4, "t_end": 36.08, "t_avail": 36.800000000000004, "ends_turn": false, "utt": 13}, {"kind": "partial", "text": "muito tipo.", "t_start": 36.08, "t_end": 36.64, "t_avail": 37.6, "ends_turn": false, "utt": 13}, {"kind": "partial", "text": "Como as coisas são porque", "t_start": 36.72, "t_end": 37.66, "t_avail": 38.2, "ends_turn": false, "utt": 13}, {"kind": "silence", "text": "<|no voice|>", "t_start": 38.400000000000006, "t_end": 38.400000000000006, "t_avail": 38.400000000000006, "ends_turn": false, "utt": 0}, {"kind": "final", "text": "tipo", "t_start": 37.68, "t_end": 37.86, "t_avail": 38.6, "ends_turn": true, "utt": 13}, {"kind": "partial", "text": "O", "t_start": 38.6, "t_end": 39.04, "t_avail": 40.400000000000006, "ends_turn": false, "utt": 14}, {"kind": "partial", "text": "de", "t_start": 39.0, "t_end": 39.08, "t_avail": 41.2, "ends_turn": false, "utt": 14}, {"kind": "partial", "text": "Massachussets é só tipo um estado liberal,", "t_start": 39.08, "t_end": 40.86, "t_avail": 41.800000000000004, "ends_turn": false, "utt": 14}, {"kind": "final", "text": "liberal, especialmente tipo onde eu sou de,", "t_start": 40.5, "t_end": 42.42, "t_avail": 44.400000000000006, "ends_turn": false, "utt": 14}, {"kind": "final", "text": "de população diversa. E agora...", "t_start": 42.42, "t_end": 44.38, "t_avail": 44.400000000000006, "ends_turn": true, "utt": 14}, {"kind": "partial", "text": "e você vai", "t_start": 44.400000000000006, "t_end": 44.400000000000006, "t_avail": 45.800000000000004, "ends_turn": false, "utt": 15}, {"kind": "partial", "text": "que tipo isso não é tipo", "t_start": 44.7, "t_end": 45.760000000000005, "t_avail": 47.2, "ends_turn": false, "utt": 15}, {"kind": "partial", "text": "tipo o resto.", "t_start": 45.96000000000001, "t_end": 46.64000000000001, "t_avail": 48.400000000000006, "ends_turn": false, "utt": 15}, {"kind": "partial", "text": "O país é tipo, eu percebi que", "t_start": 46.800000000000004, "t_end": 48.36000000000001, "t_avail": 49.2, "ends_turn": false, "utt": 15}, {"kind": "partial", "text": "tinha", "t_start": 48.36000000000001, "t_end": 48.50000000000001, "t_avail": 49.2, "ends_turn": false, "utt": 15}, {"kind": "final", "text": "tipo", "t_start": 48.480000000000004, "t_end": 49.06, "t_avail": 49.6, "ends_turn": true, "utt": 15}, {"kind": "silence", "text": "<|no voice|>", "t_start": 50.2, "t_end": 50.2, "t_avail": 50.2, "ends_turn": false, "utt": 0}, {"kind": "final", "text": "Um beijo e um abraço. Tchau!", "t_start": 49.6, "t_end": 50.120000000000005, "t_avail": 50.400000000000006, "ends_turn": true, "utt": 16}, {"kind": "partial", "text": "Tipo,", "t_start": 50.400000000000006, "t_end": 50.96000000000001, "t_avail": 51.800000000000004, "ends_turn": false, "utt": 17}, {"kind": "partial", "text": "bairros brancos e", "t_start": 51.080000000000005, "t_end": 51.900000000000006, "t_avail": 52.400000000000006, "ends_turn": false, "utt": 17}, {"kind": "final", "text": "coisas tipo assim. Mas eu nunca...", "t_start": 51.88, "t_end": 53.18000000000001, "t_avail": 53.2, "ends_turn": true, "utt": 17}, {"kind": "partial", "text": "percebi pra tipo que", "t_start": 53.2, "t_end": 54.14, "t_avail": 55.2, "ends_turn": false, "utt": 18}, {"kind": "partial", "text": "extensão. E", "t_start": 54.14, "t_end": 55.040000000000006, "t_avail": 55.800000000000004, "ends_turn": false, "utt": 18}, {"kind": "final", "text": "tipo, as famílias dele...", "t_start": 55.040000000000006, "t_end": 55.980000000000004, "t_avail": 56.0, "ends_turn": true, "utt": 18}, {"kind": "final", "text": "tipo.", "t_start": 56.0, "t_end": 56.5, "t_avail": 57.2, "ends_turn": true, "utt": 19}, {"kind": "partial", "text": "40,", "t_start": 57.2, "t_end": 57.900000000000006, "t_avail": 59.2, "ends_turn": false, "utt": 20}, {"kind": "partial", "text": "pagam para os filhos", "t_start": 58.38, "t_end": 59.14, "t_avail": 59.800000000000004, "ends_turn": false, "utt": 20}, {"kind": "partial", "text": "irem para a escola", "t_start": 59.14, "t_end": 59.82, "t_avail": 60.400000000000006, "ends_turn": false, "utt": 20}, {"kind": "partial", "text": "de internato,", "t_start": 59.82, "t_end": 60.400000000000006, "t_avail": 61.2, "ends_turn": false, "utt": 20}, {"kind": "partial", "text": "tipo 30 mil,", "t_start": 60.580000000000005, "t_end": 61.080000000000005, "t_avail": 61.800000000000004, "ends_turn": false, "utt": 20}, {"kind": "silence", "text": "<|no voice|>", "t_start": 63.6, "t_end": 63.6, "t_avail": 63.6, "ends_turn": false, "utt": 0}, {"kind": "final", "text": "40 mil, tipo por ano no ensino", "t_start": 61.14, "t_end": 62.86, "t_avail": 63.800000000000004, "ends_turn": false, "utt": 20}, {"kind": "final", "text": "médio.", "t_start": 62.86, "t_end": 63.2, "t_avail": 63.800000000000004, "ends_turn": true, "utt": 20}, {"kind": "silence", "text": "<|no voice|>", "t_start": 66.0, "t_end": 66.0, "t_avail": 66.0, "ends_turn": false, "utt": 0}, {"kind": "partial", "text": "Só tão diferente", "t_start": 63.800000000000004, "t_end": 65.08, "t_avail": 66.0, "ends_turn": false, "utt": 21}, {"kind": "final", "text": "do que?", "t_start": 65.32000000000001, "t_end": 65.54, "t_avail": 66.2, "ends_turn": true, "utt": 21}], "user_speech_spans": [[3.7, 5.8], [5.9, 6.3], [6.6, 9.1], [9.9, 13.3], [14.0, 14.5], [14.9, 16.2], [16.3, 18.3], [18.7, 19.1], [19.9, 20.3], [20.9, 24.1], [25.4, 28.4], [28.5, 29.9], [30.1, 33.8], [33.9, 38.0], [38.8, 48.9], [49.2, 49.8], [50.5, 52.6], [52.7, 54.7], [54.9, 55.3], [55.5, 56.6], [56.9, 63.2], [64.1, 65.6]], "decisions": [{"kind": "partial", "t": 5.2, "piece": "Sim,", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.075}, {"kind": "partial", "t": 5.8, "piece": "concordo. Não poderia concordar mais.", "ends_turn": false, "tag": "user_finish_speaking", "text": "É um debate, né? Às vezes, a gente precisa ouvir o lado do outro para ver a dimensão do problema.", "compute_s": 0.231}, {"kind": "final", "t": 7.0, "piece": "isso.", "ends_turn": true, "tag": "user_is_speaking", "text": "", "compute_s": 0.03}, {"kind": "silence", "t": 9.6, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.021}, {"kind": "partial", "t": 9.6, "piece": "que justamente tipo abriu meus olhos.", "ends_turn": false, "tag": "user_finish_speaking", "text": "Exatamente! É assim que a gente aprende, né?", "compute_s": 0.137}, {"kind": "final", "t": 9.8, "piece": "", "ends_turn": true, "tag": "user_is_thinking", "text": "", "compute_s": 0.023}, {"kind": "partial", "t": 11.4, "piece": "o estado", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.021}, {"kind": "partial", "t": 12.2, "piece": "tipo do país", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.021}, {"kind": "partial", "t": 13.0, "piece": "tipo tipo tipo", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.022}, {"kind": "partial", "t": 13.6, "piece": "Tiboru H", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.022}, {"kind": "silence", "t": 13.8, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.021}, {"kind": "final", "t": 14.0, "piece": "foi", "ends_turn": true, "tag": "user_is_speaking", "text": "", "compute_s": 0.022}, {"kind": "final", "t": 15.2, "piece": "e tchupu. Plush!", "ends_turn": true, "tag": "user_finish_speaking", "text": "Haha, esses nomes são demais! É bom lembrar que a polêmica é sempre mais interessante quando tem um toque de humor.", "compute_s": 0.267}, {"kind": "partial", "t": 16.6, "piece": "choque tão grande.", "ends_turn": false, "tag": "user_finish_speaking", "text": "É isso aí! O debate rende muito!", "compute_s": 0.129}, {"kind": "final", "t": 16.8, "piece": "", "ends_turn": true, "tag": "user_is_thinking", "text": "", "compute_s": 0.023}, {"kind": "partial", "t": 18.8, "piece": "Eu sempre senti", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.023}, {"kind": "final", "t": 19.0, "piece": "tipo...", "ends_turn": true, "tag": "user_is_speaking", "text": "", "compute_s": 0.023}, {"kind": "silence", "t": 19.6, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.021}, {"kind": "final", "t": 19.8, "piece": "", "ends_turn": true, "tag": "user_is_speaking", "text": "", "compute_s": 0.023}, {"kind": "silence", "t": 20.8, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.027}, {"kind": "final", "t": 21.0, "piece": "Que o...", "ends_turn": true, "tag": "user_is_speaking", "text": "", "compute_s": 0.022}, {"kind": "partial", "t": 23.6, "piece": "tipo o resto do país tava tipo", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.022}, {"kind": "partial", "t": 23.6, "piece": "numa bolha", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.023}, {"kind": "final", "t": 23.8, "piece": "e eu era tipo", "ends_turn": true, "tag": "user_is_speaking", "text": "", "compute_s": 0.023}, {"kind": "silence", "t": 24.6, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.022}, {"kind": "final", "t": 24.8, "piece": "Pô.", "ends_turn": true, "tag": "user_finish_speaking", "text": "Entendo essa sensação de isolamento. É um peso emocional grande.", "compute_s": 0.155}, {"kind": "partial", "t": 27.0, "piece": "Tipo, eu morava", "ends_turn": false, "tag": "user_interruption", "text": "", "compute_s": 0.024}, {"kind": "partial", "t": 27.6, "piece": "numa comunidade", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.022}, {"kind": "partial", "t": 28.2, "piece": "tão", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.023}, {"kind": "final", "t": 29.0, "piece": "diversa que é tipo, é tipo a", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.022}, {"kind": "final", "t": 29.0, "piece": "merda.", "ends_turn": true, "tag": "user_finish_speaking", "text": "Ah, as diferenças locais são gigantescas! É um fator que sempre complica a visão geral do país.", "compute_s": 0.242}, {"kind": "final", "t": 30.6, "piece": "A América é ótimo, mas...", "ends_turn": true, "tag": "user_is_speaking", "text": "", "compute_s": 0.026}, {"kind": "partial", "t": 32.0, "piece": "quando vim pra cá,", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.024}, {"kind": "partial", "t": 32.6, "piece": "percebi que era quem", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.022}, {"kind": "partial", "t": 33.2, "piece": "tava", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.024}, {"kind": "partial", "t": 33.8, "piece": "morando", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.023}, {"kind": "final", "t": 34.4, "piece": "morando na bolê. Pô, isso mudou tudo.", "ends_turn": true, "tag": "user_finish_speaking", "text": "Mudou mesmo! O que te faz mudar de ideia é sempre um fator social .", "compute_s": 0.204}, {"kind": "partial", "t": 35.6, "piece": "totalmente", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.026}, {"kind": "partial", "t": 36.2, "piece": "tipo minha", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.023}, {"kind": "partial", "t": 36.8, "piece": "perspectiva de", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.024}, {"kind": "partial", "t": 37.6, "piece": "muito tipo.", "ends_turn": false, "tag": "user_finish_speaking", "text": "É isso! É assim que a gente evolui.", "compute_s": 0.134}, {"kind": "partial", "t": 38.2, "piece": "Como as coisas são porque", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.025}, {"kind": "silence", "t": 38.4, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.023}, {"kind": "final", "t": 38.6, "piece": "tipo", "ends_turn": true, "tag": "user_is_speaking", "text": "", "compute_s": 0.024}, {"kind": "partial", "t": 40.4, "piece": "O", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.023}, {"kind": "partial", "t": 41.2, "piece": "de", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.027}, {"kind": "partial", "t": 41.8, "piece": "Massachussets é só tipo um estado liberal,", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.024}, {"kind": "final", "t": 44.4, "piece": "liberal, especialmente tipo onde eu sou de,", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.024}, {"kind": "final", "t": 44.4, "piece": "de população diversa. E agora...", "ends_turn": true, "tag": "user_finish_speaking", "text": "Faz sentido! O perfil do estado influencia muito na cultura política.", "compute_s": 0.154}, {"kind": "partial", "t": 45.8, "piece": "e você vai", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.252}, {"kind": "partial", "t": 47.2, "piece": "que tipo isso não é tipo", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.151}, {"kind": "partial", "t": 48.4, "piece": "tipo o resto.", "ends_turn": false, "tag": "user_finish_speaking", "text": "Não é um \"tipo\" único, é um esquema de interação constante.", "compute_s": 0.389}, {"kind": "partial", "t": 49.2, "piece": "O país é tipo, eu percebi que", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.283}, {"kind": "partial", "t": 49.2, "piece": "tinha", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.146}, {"kind": "final", "t": 49.6, "piece": "tipo", "ends_turn": true, "tag": "user_is_speaking", "text": "", "compute_s": 0.226}, {"kind": "silence", "t": 50.2, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.227}, {"kind": "final", "t": 50.4, "piece": "Um beijo e um abraço. Tchau!", "ends_turn": true, "tag": "user_finish_speaking", "text": "Tchau! Bora trocar mais tarde!", "compute_s": 0.335}, {"kind": "partial", "t": 51.8, "piece": "Tipo,", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.138}, {"kind": "partial", "t": 52.4, "piece": "bairros brancos e", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.149}, {"kind": "final", "t": 53.2, "piece": "coisas tipo assim. Mas eu nunca...", "ends_turn": true, "tag": "user_finish_speaking", "text": "É um tema que sempre gera muita discussão, vi u?", "compute_s": 0.355}, {"kind": "partial", "t": 55.2, "piece": "percebi pra tipo que", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.232}, {"kind": "partial", "t": 55.8, "piece": "extensão. E", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.147}, {"kind": "final", "t": 56.0, "piece": "tipo, as famílias dele...", "ends_turn": true, "tag": "user_finish_speaking", "text": "É sobre a complexidade da realidade, não sobre um único lado.", "compute_s": 0.361}, {"kind": "final", "t": 57.2, "piece": "tipo.", "ends_turn": true, "tag": "user_finish_speaking", "text": "Exatamente! É sobre a nuance, não sobre o passado.", "compute_s": 0.365}, {"kind": "partial", "t": 59.2, "piece": "40,", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.236}, {"kind": "partial", "t": 59.8, "piece": "pagam para os filhos", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.153}, {"kind": "partial", "t": 60.4, "piece": "irem para a escola", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.234}, {"kind": "partial", "t": 61.2, "piece": "de internato,", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.157}, {"kind": "partial", "t": 61.8, "piece": "tipo 30 mil,", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.242}, {"kind": "silence", "t": 63.6, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.232}, {"kind": "final", "t": 63.8, "piece": "40 mil, tipo por ano no ensino", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.216}, {"kind": "final", "t": 63.8, "piece": "médio.", "ends_turn": true, "tag": "user_finish_speaking", "text": "Esses custos são bem altos, realmente. É um fator decisivo para a escolha de cursos.", "compute_s": 0.486}, {"kind": "silence", "t": 66.0, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_thinking", "text": "", "compute_s": 0.25}, {"kind": "partial", "t": 66.0, "piece": "Só tão diferente", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.296}, {"kind": "final", "t": 66.2, "piece": "do que?", "ends_turn": true, "tag": "user_finish_speaking", "text": "Principalmente na infraestrutura de apoio e na disponibilidade de bolsas.", "compute_s": 0.409}], "render": {"placed_speech_s": 22.597, "placed_within_input_s": 18.997, "speech_beyond_input_s": 3.6, "clipped_speech_s": 0.0, "tail_s": 4.0, "turns": 16}}