er_is_speaking", "text": "", "compute_s": 0.024}, {"kind": "final", "t": 33.4, "piece": "", "ends_turn": true, "tag": "user_is_speaking", "text": "", "compute_s": 0.025}, {"kind": "partial", "t": 34.6, "piece": "Eu tô tão feliz", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.025}, {"kind": "partial", "t": 35.2, "piece": "que estão", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.025}, {"kind": "final", "t": 36.2, "piece": "tipo, reformando, mas a Miru...", "ends_turn": true, "tag": "user_finish_speaking", "text": "Acho que você tá super animado com essa mudança! Se precisar de mais dicas sobre a região ou sobre a adaptação, é só chamar !", "compute_s": 0.29}, {"kind": "final", "t": 37.6, "piece": "mundo", "ends_turn": true, "tag": "user_is_speaking", "text": "", "compute_s": 0.029}, {"kind": "silence", "t": 39.4, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.338}, {"kind": "partial", "t": 39.4, "piece": "Só uma estrutura estranha", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.322}, {"kind": "final", "t": 39.6, "piece": "na...", "ends_turn": true, "tag": "user_finish_speaking", "text": "Sem problemas! É sempre bom registrar essas diferenças. Às vezes, a estrutura é diferente, mas o conforto vem do conhecimento do lugar.", "compute_s": 0.451}, {"kind": "silence", "t": 41.0, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_thinking", "text": "", "compute_s": 0.332}, {"kind": "final", "t": 41.2, "piece": "Os banheiros...", "ends_turn": true, "tag": "user_is_speaking", "text": "", "compute_s": 0.194}, {"kind": "silence", "t": 41.8, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.324}], "render": {"placed_speech_s": 13.947, "placed_within_input_s": 13.947, "speech_beyond_input_s": 0, "clipped_speech_s": 0.0, "tail_s": 4.0, "turns": 12}}