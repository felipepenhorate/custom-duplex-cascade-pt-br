": 0.049, "would_have_played_s": 6.8, "asr_settle_s": 0.9}], "utt_finalized": 17, "utt_skipped": {"digital_silence": 1}, "audio_beyond_input_s": 0.0, "tts_capped": 1, "tts_capped_words": 2, "paused_floor_take": null, "interrupt_span": null, "post_interrupt_text": "", "took_floor_after_interrupt": false, "tags": ["user_is_speaking:empty", "user_finish_speaking", "user_is_thinking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_finish_speaking", "user_interruption:empty", "user_finish_speaking", "user_finish_speaking", "user_finish_speaking", "user_is_thinking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_finish_speaking", "user_finish_speaking", "user_interruption:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_finish_speaking", "user_is_speaking:empty", "user_is_speaking:empty", "user_finish_speaking", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_finish_speaking", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_finish_speaking", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_finish_speaking", "user_is_thinking:empty", "user_is_speaking:empty", "user_is_speaking:empty"], "turns": [{"start": 5.605, "end": 6.822, "natural_end": 14.645, "dur": 1.216, "text": "Sim, eu super gosto! O clima lá é bem agradável, com verões mais amenas e invernos que não são tão rigorosos. Tem umas vantagens ótimas, tipo a paisagem e o movimento cultural.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 32, "stopped": true}, {"start": 8.578, "end": 9.627, "natural_end": 18.418, "dur": 1.048, "text": "Com certeza! O social é um pilar, né? Você precisa equilibrar isso com o tempo de trabalho e de lazer. Tentar manter um horário de \"reunião\" com amigos ajuda muito.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 30, "stopped": true}, {"start": 10.761, "end": 11.256, "natural_end": 19.721, "dur": 0.495, "text": "É bem estruturada, sim. Tem um bom sistema de saúde e serviços, o que facilita muito a rotina. Mas é bom ficar de olho nos custos de vida, principalmente em imóveis.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 31, "stopped": true}, {"start": 11.956, "end": 12.768, "natural_end": 20.916, "dur": 0.812, "text": "Ah, depende muito do seu perfil! Se você busca mais agito, as cidades maiores são ótimas. Se prefere um ritmo mais tranquilo, as áreas residenciais podem ser perfeitas.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 28, "stopped": true}, {"start": 13.068, "end": 13.527, "natural_end": 18.748, "dur": 0.459, "text": "Entendo. Às vezes, a gente precisa se adaptar aos ritmos locais, né? É um processo de aprendizado contínuo.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 18, "stopped": true}, {"start": 18.348, "end": 19.057, "natural_end": 26.588, "dur": 0.709, "text": "Isso é bem comum! Os bairros costumam ter uma mistura de áreas mais comerc iais e residenciais. É bom pesquisar bem sobre o bairro específico que te interessa.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 28, "stopped": true}, {"start": 19.357, "end": 19.426, "natural_end": 23.917, "dur": 0.068, "text": "Exatamente! O que mais te preocupa nessa mudança?", "tag": "user_finish_speaking", "kind": "speech", "n_words": 8, "stopped": true}, {"start": 23.308, "end": 29.868, "natural_end": 29.868, "dur": 6.56, "text": "Não é assim. Geralmente, a segurança é alta, mas é sempre bom ter cautela, especialmente à noite. Ficar atento ao entorno ajuda muito.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 23, "stopped": false}, {"start": 29.868, "end": 29.868, "natural_end": 36.348, "dur": 0.0, "text": "Perfeito! Um quarto extra pode ser ótimo para ter um espaço mais reservado para o descanso ou para um trabalho mais tranquilo.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 22, "stopped": true}, {"start": 31.93, "end": 33.325, "natural_end": 40.41, "dur": 1.396, "text": "Sei que pode parecer estranho no começo, mas o tempo passa e você ac ostuma. O importante é criar os seus próprios ritmos e convites.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 25, "stopped": true}, {"start": 36.49, "end": 37.429, "natural_end": 43.93, "dur": 0.939, "text": "Acho que você tá super animado com essa mudança! Se precisar de mais dicas sobre a região ou sobre a adaptação, é só chamar !", "tag": "user_finish_speaking", "kind": "speech", "n_words": 25, "stopped": true}, {"start": 40.051, "end": 40.294, "natural_end": 46.851, "dur": 0.243, "text": "Sem problemas! É sempre bom registrar essas diferenças. Às vezes, a estrutura é diferente, mas o conforto vem do conhecimento", "tag": "user_finish_speaking", "kind": "speech", "n_words": 20, "stopped": true}], "user_pieces": [{"kind": "partial", "text": "Você gosta de morar no", "t_start": 2.76, "t_end": 3.86, "t_avail": 4.4, "ends_turn": false, "utt": 0}, {"kind": "final", "text": "sul, tipo?", "t_start": 3.86, "t_end": 4.26, "t_avail": 5.2, "ends_turn": true, "utt": 0}, {"kind": "silence", "text": "<|no voice|>", "t_start": 5.800000000000001, "t_end": 5.800000000000001, "t_avail": 5.800000000000001, "ends_turn": false, "utt": 0}, {"kind": "final", "text": "É? S*****", "t_start": 5.6000000000000005, "t_end": 6.98, "t_avail": 7.0, "ends_turn": true, "utt": 1}, {"kind": "final", "text": "social. A forma que a gente faz", "t_start": 7.0, "t_end": 8.18, "t_avail": 8.200000000000001, "ends_turn": false, "utt": 2}, {"kind": "final", "text": "é muito importante.", "t_start": 8.18, "t_end": 8.18, "t_avail": 8.200000000000001, "ends_turn": true, "utt": 2}, {"kind": "partial", "text": "como o rosto é", "t_start": 8.200000000000001, "t_end": 8.920000000000002, "t_avail": 9.600000000000001, "ends_turn": false, "utt": 3}, {"kind": "final", "text": "é estruturada, é tão...", "t_start": 8.88, "t_end": 10.38, "t_avail": 10.4, "ends_turn": true, "utt": 3}, {"kind": "final", "text": "estranha no que tipo...", "t_start": 10.4, "t_end": 11.56, "t_avail": 11.600000000000001, "ends_turn": true, "utt": 4}, {"kind": "final", "text": "corredor.", "t_start": 11.600000000000001, "t_end": 12.38, "t_avail": 12.8, "ends_turn": true, "utt": 5}, {"kind": "final", "text": "", "t_start": 13.8, "t_end": 13.8, "t_avail": 13.8, "ends_turn": true, "utt": 6}, {"kind": "partial", "text": "meio tipo um corredor", "t_start": 13.8, "t_end": 14.760000000000002, "t_avail": 15.4, "ends_turn": false, "utt": 7}, {"kind": "partial", "text": "normal mas", "t_start": 14.760000000000002, "t_end": 15.3, "t_avail": 16.2, "ends_turn": false, "utt": 7}, {"kind": "partial", "text": "depois tem tipo", "t_start": 15.3, "t_end": 16.04, "t_avail": 16.8, "ends_turn": false, "utt": 7}, {"kind": "partial", "text": "raminhos", "t_start": 16.04, "t_end": 16.5, "t_avail": 17.400000000000002, "ends_turn": false, "utt": 7}, {"kind": "final", "text": "raminho de 1, 2, 4...", "t_start": 16.18, "t_end": 17.98, "t_avail": 18.0, "ends_turn": true, "utt": 7}, {"kind": "partial", "text": "diferentes.", "t_start": 18.0, "t_end": 18.58, "t_avail": 19.200000000000003, "ends_turn": false, "utt": 8}, {"kind": "final", "text": "E sai, então.", "t_start": 19.0, "t_end": 19.38, "t_avail": 19.400000000000002, "ends_turn": true, "utt": 8}, {"kind": "partial", "text": "Então você não é, tipo, se você", "t_start": 19.400000000000002, "t_end": 20.6, "t_avail": 22.200000000000003, "ends_turn": false, "utt": 9}, {"kind": "partial", "text": "abre a porta só tem,", "t_start": 20.6, "t_end": 21.660000000000004, "t_avail": 22.200000000000003, "ends_turn": false, "utt": 9}, {"kind": "partial", "text": "tipo...", "t_start": 21.860000000000003, "t_end": 22.26, "t_avail": 23.0, "ends_turn": false, "utt": 9}, {"kind": "partial", "text": "então mais um quarto por", "t_start": 22.26, "t_end": 23.080000000000002, "t_avail": 23.6, "ends_turn": false, "utt": 9}, {"kind": "silence", "text": "<|no voice|>", "t_start": 23.8, "t_end": 23.8, "t_avail": 23.8, "ends_turn": false, "utt": 0}, {"kind": "final", "text": "pé.", "t_start": 23.080000000000002, "t_end": 23.240000000000002, "t_avail": 24.0, "ends_turn": true, "utt": 9}, {"kind": "partial", "text": "Então eu sinto", "t_start": 24.0, "t_end": 24.68, "t_avail": 25.200000000000003, "ends_turn": false, "utt": 10}, {"kind": "silence", "text": "<|no voice|>", "t_start": 25.400000000000002, "t_end": 25.400000000000002, "t_avail": 25.400000000000002, "ends_turn": false, "utt": 0}, {"kind": "final", "text": "que...", "t_start": 24.68, "t_end": 25.26, "t_avail": 25.6, "ends_turn": true, "utt": 10}, {"kind": "partial", "text": "muito mais", "t_start": 25.6, "t_end": 26.26, "t_avail": 27.0, "ends_turn": false, "utt": 11}, {"kind": "partial", "text": "mais potencial para a interação", "t_start": 26.080000000000002, "t_end": 27.44, "t_avail": 28.200000000000003, "ends_turn": false, "utt": 11}, {"kind": "partial", "text": "social", "t_start": 27.46, "t_end": 27.880000000000003, "t_avail": 29.0, "ends_turn": false, "utt": 11}, {"kind": "partial", "text": "se for só um corredor", "t_start": 27.880000000000003, "t_end": 28.94, "t_avail": 29.6, "ends_turn": false, "utt": 11}, {"kind": "partial", "text": "tipo portas,", "t_start": 29.14, "t_end": 30.080000000000002, "t_avail": 31.0, "ends_turn": false, "utt": 11}, {"kind": "final", "text": "portas, tipo como é, é super estranho.", "t_start": 29.540000000000003, "t_end": 31.580000000000002, "t_avail": 31.6, "ends_turn": true, "utt": 11}, {"kind": "partial", "text": "Eu tenho, tenho", "t_start": 31.6, "t_end": 32.28, "t_avail": 32.800000000000004, "ends_turn": false, "utt": 12}, {"kind": "silence", "text": "<|no voice|>", "t_start": 33.2, "t_end": 