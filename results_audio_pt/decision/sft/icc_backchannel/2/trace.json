n_s": 0.026, "flush_before_playback": true}, {"speech_onset": 42.7, "stop_at": 42.921, "reaction_s": 0.221, "played_before_stop_s": 0.61, "would_have_played_s": 5.68, "asr_settle_s": 0.3}], "utt_finalized": 17, "utt_skipped": {"digital_silence": 1}, "audio_beyond_input_s": 1.072, "tts_capped": 2, "tts_capped_words": 42, "paused_floor_take": null, "interrupt_span": null, "post_interrupt_text": "", "took_floor_after_interrupt": false, "tags": ["user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_finish_speaking", "user_is_thinking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_finish_speaking", "user_interruption:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_finish_speaking", "user_is_speaking:empty", "user_finish_speaking", "user_is_thinking:empty", "user_finish_speaking", "user_is_thinking:empty", "user_finish_speaking", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_finish_speaking", "user_is_thinking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_finish_speaking", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_finish_speaking", "user_is_speaking:empty", "user_finish_speaking", "user_is_speaking:empty", "user_finish_speaking", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_finish_speaking", "user_is_thinking:empty", "user_is_thinking:empty", "user_is_speaking:empty", "user_is_speaking:empty"], "turns": [{"start": 6.118, "end": 6.921, "natural_end": 14.998, "dur": 0.803, "text": "Opa! Depende muito do que você quer, mas geralmente tem opções bem bacanas em cidades menores ou até mesmo em bairros mais movimentados de grandes cidades.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 26, "stopped": true}, {"start": 12.595, "end": 13.628, "natural_end": 24.035, "dur": 1.033, "text": "Entendo sua preocupação com a legislação, e é fundamental ficar atento às leis locais . Em algumas regiões, a venda de produtos de uso doméstico pode ser mais restr ita, então é bom checar os limites.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 36, "stopped": true}, {"start": 16.013, "end": 16.134, "natural_end": 25.773, "dur": 0.121, "text": "Exatamente! É preciso equilibrar o desejo de venda com o respeito às normas. Se for um produto mais complexo, talvez seja melhor começar com algo mais simples ou procurar um ponto de venda que já tenha esse perfil.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 38, "stopped": true}, {"start": 17.927, "end": 18.706, "natural_end": 27.207, "dur": 0.779, "text": "Essa é uma situação bem séria, e o ideal é buscar orientação jurídica específica para o seu caso. Não adianta só pensar, é preciso saber os passos legais para seguir.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 30, "stopped": true}, {"start": 19.806, "end": 20.701, "natural_end": 32.126, "dur": 0.896, "text": "Você precisa pensar em como o produto será usado, porque isso define se é mais um \"comestível\" ou um \"materia-prima\". Se for um item de uso doméstico, a legislação costuma ser mais amigável, mas sempre confira.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 36, "stopped": true}, {"start": 22.001, "end": 25.323, "natural_end": 32.641, "dur": 3.322, "text": "Se o risco de leis é alto, talvez seja melhor focar em um nicho mais estre itado, tipo artesanato com certificação local. Assim, você garante que está dentro dos parâmetros legais e ainda sai com qualidade.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 36, "stopped": true}, {"start": 26.092, "end": 26.925, "natural_end": 33.532, "dur": 0.833, "text": "É isso aí! O mercado de nicho abre portas para quem pensa criativamente, e isso pode ser um caminho mais seguro para começar a sua jornada de venda.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 28, "stopped": true}, {"start": 29.885, "end": 31.129, "natural_end": 38.205, "dur": 1.244, "text": "Não é um \"tudo ou nada\", mas sim um \"pode ser\". O segredo é sempre pesquisar o cenário local para não se arriscar demais.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 24, "stopped": true}, {"start": 34.55, "end": 35.53, "natural_end": 42.23, "dur": 0.98, "text": "É sempre bom ter base em fatos e não só em crença. Se você encontrar um ponto de venda que já tenha um produto parecido, pergunte sobre como eles lidam com as restrições.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 33, "stopped": true}, {"start": 36.384, "end": 45.744, "natural_end": 45.744, "dur": 9.36, "text": "Se o risco for muito alto, o melhor caminho pode ser pausar a ideia por um tempo para estudar mais sobre as leis e talvez testar em um ambiente mais controlado, como um pequeno evento local.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 36, "stopped": false}, {"start": 45.744, "end": 45.744, "natural_end": 46.064, "dur": 0.0, "text": "Não podemos garantir isso para todos, mas podemos garantir", "tag": "user_finish_speaking", "kind": "speech", "n_words": 9, "stopped": true}, {"start": 42.09, "end": 42.921, "natural_end": 47.77, "dur": 0.831, "text": "Se for um produto de alto risco, o melhor caminho pode ser começar com pequenas vendas online ou em grupos de", "tag": "user_finish_speaking", "kind": "speech", "n_words": 21, "stopped": true}], "user_pieces": [{"kind": "partial", "text": "bem", "t_start": 1.71, "t_end": 2.35, "t_avail": 3.2, "ends_turn": false, "utt": 0}, {"kind": "partial", "text": "essa é uma", "t_start": 3.29, "t_end": 3.61, "t_avail": 4.4, "ends_turn": false, "utt": 0}, {"kind": "partial", "text": "ótima pergunta.", "t_start": 3.59, "t_end": 4.31, "t_avail": 5.2, "ends_turn": false, "utt": 0}, {"