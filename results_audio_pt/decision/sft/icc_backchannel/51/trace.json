_s": 0.36, "flush_before_playback": true}, {"speech_onset": 62.3, "stop_at": 62.816, "reaction_s": 0.516, "played_before_stop_s": 0.212, "would_have_played_s": 5.04, "asr_settle_s": 0.9}, {"speech_onset": 63.6, "stop_at": 63.916, "reaction_s": 0.207, "flush_before_playback": true}, {"speech_onset": 66.5, "stop_at": 66.896, "reaction_s": 0.326, "flush_before_playback": true}], "utt_finalized": 25, "utt_skipped": {"digital_silence": 1}, "audio_beyond_input_s": 2.64, "tts_capped": 1, "tts_capped_words": 15, "paused_floor_take": null, "interrupt_span": null, "post_interrupt_text": "", "took_floor_after_interrupt": false, "tags": ["user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_finish_speaking", "user_is_speaking:empty", "user_is_speaking:empty", "user_finish_speaking", "user_is_thinking:empty", "user_is_thinking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_finish_speaking", "user_is_thinking:empty", "user_is_thinking:empty", "user_finish_speaking", "user_interruption:empty", "user_is_speaking:empty", "user_finish_speaking", "user_interruption:empty", "user_finish_speaking", "user_finish_speaking", "user_is_speaking:empty", "user_finish_speaking", "user_is_thinking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_finish_speaking", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_finish_speaking", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_finish_speaking", "user_is_thinking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_finish_speaking", "user_is_speaking:empty", "user_is_speaking:empty", "user_finish_speaking", "user_is_thinking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_finish_speaking", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_finish_speaking", "user_finish_speaking", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_finish_speaking", "user_is_speaking:empty", "user_is_speaking:empty", "user_finish_speaking", "user_is_speaking:empty", "user_is_speaking:empty", "user_finish_speaking", "user_is_thinking:empty", "user_is_thinking:empty", "user_finish_speaking", "user_is_thinking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_finish_speaking", "user_is_speaking:empty", "user_is_speaking:empty", "user_finish_speaking", "user_is_thinking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty"], "turns": [{"start": 10.853, "end": 18.693, "natural_end": 18.693, "dur": 7.84, "text": "É um direito básico, sim. O Código de Defesa do Consumidor garante isso, e é fundamental para que o consumidor consiga um serviço de qualidade.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 25, "stopped": false}, {"start": 18.693, "end": 18.693, "natural_end": 28.613, "dur": 0.0, "text": "Nisso eu entendo perfeitamente. Às vezes, a pressão social é enorme, e é preciso ter a força para manter a firmeza. É um processo de superação constante.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 27, "stopped": true}, {"start": 16.577, "end": 19.031, "natural_end": 24.737, "dur": 2.453, "text": "Exatamente. É crucial que a reação seja proporcional e focada em resolver o problema, e não em causar mais dor. Isso ajuda a manter a paz.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 26, "stopped": true}, {"start": 19.531, "end": 19.531, "natural_end": 27.131, "dur": 0.0, "text": "É um desafio, mas com planejamento, você consegue gerenciar bem essas situações. Lembre-se que a calma é sempre a melhor tática.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 21, "stopped": true}, {"start": 20.394, "end": 20.394, "natural_end": 29.834, "dur": 0.0, "text": "É um direito seu, e você tem todo o direito de exigir isso. Não hesite em buscar ajuda jurídica se o caso for muito sério.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 25, "stopped": true}, {"start": 22.417, "end": 29.777, "natural_end": 29.777, "dur": 7.36, "text": "A justiça é um processo, não um evento único. Ela envolve muita paciência e consistência, especialmente quando você está lutando por algo grande.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 23, "stopped": false}, {"start": 29.777, "end": 29.777, "natural_end": 38.817, "dur": 0.0, "text": "É verdade. Às vezes, as instituições precisam de mais tempo para anal isar, o que pode esticar o período da sua insatisfação. É importante ter paciência nesse caminho.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 28, "stopped": true}, {"start": 28.709, "end": 28.709, "natural_end": 37.989, "dur": 0.0, "text": "Com certeza. O mundo é complexo, e as leis buscam equilibrar isso. É sempre bom verificar os limites legais antes de tomar qualquer atitude drástica.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 25, "stopped": true}, {"start": 34.799, "end": 46.239, "natural_end": 46.239, "dur": 11.44, "text": "Não é verdade. O Código de Defesa do Consumidor é um direito garantido, e não depende de \"quem mais fez\". Você pode buscar orientação em órgãos de defesa do consumidor da sua região.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 33, "stopped": false}, {"start": 46.239, "end": 46.239, "natural_end": 53.439, "dur": 0.0, "text": "É um direito que deve ser respeitado, sim. Mas também é importante lembrar que o direito de defesa é um direito do acusado, não do promotor.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 26, "stopped": true}, {"start": 40.281, "end": 41.239, "natural_end": 47.081, "dur": 0.958, "text": "Pode ser um ponto de partida, mas o foco principal deve ser a proposta de resolução do problema. O segredo é sempre buscar um acordo primeiro.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 26, "stopped": true}, {"start": 46.931, "end": 55.571, "natural_end": 55.571, "dur": 8.64, "text": "Essa é uma proposta muito radical, e ela exige muita discussão política. É um tema que envolve muita complexidade social e legal.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 22, "stopped": false}, {"start": 55.571, "end": 55.571, "natural_end": 60.451, "dur": 0.0, "text": "É um tema que exige muita reflexão profunda, porque ele muda o conceito de culpa e de recompensa.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 18, "stopped": true}, {"start": 51.79, "end": 51.79, "natural_end": 59.31, "dur": 0.0, "text": "Exatamente. O que o mundo espera do governo é que ele resolva essas questões complexas de forma justa e sustentável para todos.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 22, "stopped": true}, {"start": 51.691, "end": 52.42, "natural_end": 60.571, "dur": 0.729, "text": "É um debate eterno, e não tem resposta única. O importante é que, em qualquer sistema, existe um limite de proporcionalidade que deve ser respeitado.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 25, "stopped": true}, {"start": 52.82, "end": 58.66, "natural_end": 58.66, "dur": 5.84, "text": "De nada! Se precisar de mais alguma coisa, é só chamar. Estou aqui para ajudar no que for preciso.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 19, "stopped": false}, {"start": 58.66, "end": 58.66, "natural_end": 65.3, "dur": 0.0, "text": "Entendo perfeitamente essa sensação de desigualdade. É um desafio social enorme, e a gente precisa de mais conversas assim.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 19, "stopped": true}, {"start": 60.644, "end": 60.86, "natural_end": 69.604, "dur": 0.216, "text": "Sim, é um ponto crucial. O sistema tem um histórico de aplicar a pena de mort e mais frequentemente em grupos mais vulneráveis, o que ger a muita insatisfação.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 29, "stopped": true}, {"start": 62.088, "end": 62.816, "natural_end": 67.128, "dur": 0.728, "text": "É um debate constante, e a gente precisa de mais dados para entender a dimensão do problema.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 17, "stopped": true}, {"start": 63.916, "end": 63.916, "natural_end": 64.396, "dur": 0.0, "text": "Com certeza.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 2, "stopped": true}, {"start": 66.896, "end": 66.896, "natural_end": 73.776, "dur": 0.0, "text": "É um sentimento muito forte, e é super válido . É um direito que deve ser protegido de qualquer forma possível.", "tag": "user_finish_speaking", "kind": "speech", "n_words": 21, "stopped": true}, {"start": 71.613, "end": 74.253, "natural_end": 74.253, "dur": 2.64, "text": "Ele se encaixa porque a própria proposta de manter a pena", "tag": "user_finish_speaking", "kind": "speech", "n_words": 11, "stopped": false}], "user_pieces": [{"kind": "partial", "text": "para", "t_start": 1.81, "t_end": 2.43, "t_avail": 3.2, "ends_turn": false, "utt": 0}, {"kind": "partial", "text": "receber a pena de", "t_start": 2.67, "t_end": 3.65, "t_avail": 4.4, "ends_turn": false, "utt": 0}, {"kind": "partial", "text": "morte, mas se você", "t_start": 3.65, "t_end": 4.59, "t_avail": 5.2, "ends_turn": false, "utt": 0}, {"kind": "partial", "text": "pensar bem,", "t_start": 4.59, "t_end": 5.13, "t_avail": 5.800000000000001, "ends_turn": false, "utt": 0}, {"kind": "partial", "text": "se basear", "t_start": 5.25, "t_end": 5.67, "t_avail": 6.6000000000000005, "ends_turn": false, "utt": 0}, {"kind": "final", "text": "qualquer.", "t_start": 5.67, "t_end": 6.07, "t_avail": 6.800000000000001, "ends_turn": true, "utt": 0}, {"kind": "partial", "text": "decisão moral no que as outras", "t_start": 6.800000000000001, "t_end": 8.34, "t_avail": 9.0, "ends_turn": false, "utt": 1}, {"kind": "silence", "text": "<|no voice|>", "t_start": 9.600000000000001, "t_end": 9.600000000000001, "t_avail": 9.600000000000001, "ends_turn": false, "utt": 0}, {"kind": "partial", "text": "pessoas sentem.", "t_start": 8.3, "t_end": 9.08, "t_avail": 9.600000000000001, "ends_turn": false, "utt": 1}, {"kind": "final", "text": "", "t_start": 9.8, "t_end": 9.8, "t_avail": 9.8, "ends_turn": true, "utt": 1}, {"kind": "silence", "text": "<|no voice|>", "t_start": 13.0, "t_end": 13.0, "t_avail": 13.0, "ends_turn": false, "utt": 0}, {"kind": "partial", "text": "Mas é", "t_start": 9.8, "t_end": 10.32, "t_avail": 13.0, "ends_turn": false, "utt": 2}, {"kind": "final", "text": "ada em sentimentos de vingança, então você", "t_start": 10.32, "t_end": 11.540000000000001, "t_avail": 13.200000000000001, "ends_turn": false, "utt": 2}, {"kind": "final", "text": "não vai ter um bom bobum.", "t_start": 11.540000000000001, "t_end": 12.360000000000001, "t_avail": 13.200000000000001, "ends_turn": true, "utt": 2}, {"kind": "silence", "text": "<|no voice|>", "t_start": 13.8, "t_end": 13.8, "t_avail": 13.8, "ends_turn": false, "utt": 0}, {"kind": "silence", "text": "<|no voice|>", "t_start": 14.4, "t_end": 14.4, "t_avail": 14.4, "ends_turn": false, "utt": 0}, {"kind": "partial", "text": "sistema moral.", "t_start": 14.66, "t_end": 15.56, "t_avail": 16.2, "ends_turn": false, "utt": 3}, {"kind": "partial", "text": "O legal de", "t_start": 15.600000000000001, "t_end": 16.16, "t_avail": 16.8, "ends_turn": false, "utt": 3}, {"kind": "partial", "text": "justi...", "t_start": 16.14, "t_end": 16.740000000000002, "t_avail": 17.400000000000002, "ends_turn": false, "utt": 3}, {"kind": "final", "text": "É! E aqui tá...", "t_start": 16.720000000000002, "t_end": 17.580000000000002, "t_avail": 17.6, "ends_turn": true, "utt": 3}, {"kind": "final", "text": "Outro argumento que eu vou dizer, a", "t_start": 17.6, "t_end": 19.380000000000003, "t_avail": 19.6, "ends_turn": false, "utt": 4}, {"kind": "final", "text": "justiça...", "t_start": 19.380000000000003, "t_end": 19.580000000000002, "t_avail": 19.6, "ends_turn": true, "utt": 4}, {"kind": "partial", "text": "não é distribuída igualmente.", "t_start": 19.6, "t_end": 21.060000000000002, "t_avail": 22.200000000000003, "ends_turn": false, "utt": 5}, {"kind": "partial", "text": "É a adição muito mais proporcionalmente do", "t_start": 21.080000000000002, "t_end": 23.66, "t_avail": 25.0, "ends_turn": false, "utt": 5}, {"kind": "partial", "text": "mundo.", "t_start": 23.66, "t_end": 24.020000000000003, "t_avail": 25.0, "ends_turn": false, "utt": 5}, {"kind": "silence", "text": "<|no voice|>", "t_start": 25.200000000000003, "t_end": 25.200000000000003, "t_avail": 25.200000000000003, "ends_turn": false, "utt": 0}, {"kind": "final", "text": "", "t_start": 25.400000000000002, "t_end": 25.400000000000002, "t_avail": 25.400000000000002, "ends_turn": true, "utt": 5}, {"kind": "silence", "text": "<|no voice|>", "t_start": 26.200000000000003, "t_end": 26.200000000000003, "t_avail": 26.200000000000003, "ends_turn": false, "utt": 0}, {"kind": "final", "text": "PEN -", "t_start": 25.400000000000002, "t_end": 25.820000000000004, "t_avail": 26.400000000000002, "ends_turn": true, "utt": 6}, {"kind": "partial", "text": "Outras pessoas brancas que", "t_start": 26.51, "t_end": 27.990000000000002, "t_avail": 28.6, "ends_turn": false, "utt": 7}, {"kind": "partial", "text": "cometeram os", "t_start": 27.990000000000002, "t_end": 28.55, "t_avail": 29.200000000000003, "ends_turn": false, "utt": 7}, {"kind": "partial", "text": "mesmos crimes em", "t_start": 28.55, "t_end": 29.310000000000002, "t_avail": 30.0, "ends_turn": false, "utt": 7}, {"kind": "partial", "text": "múltiplos", "t_start": 29.270000000000003, "t_end": 29.790000000000003, "t_avail": 30.6, "ends_turn": false, "utt": 7}, {"kind": "final", "text": "estados. Mas isso não é verdade.", "t_start": 29.790000000000003, "t_end": 30.970000000000002, "t_avail": 31.0, "ends_turn": true, "utt": 7}, {"kind": "partial", "text": "significa", "t_start": 31.0, "t_end": 31.56, "t_avail": 32.2, "ends_turn": false, "utt": 8}, {"kind": "partial", "text": "que devamos", "t_start": 31.5, "t_end": 32.18, "t_avail": 32.800000000000004, "ends_turn": false, "utt": 8}, {"kind": "partial", "text": "ou não ter", "t_start": 32.18, "t_end": 32.66, "t_avail": 33.6, "ends_turn": false, "utt": 8}, {"kind": "silence", "text": "<|no voice|>", "t_start": 34.0, "t_end": 34.0, "t_avail": 34.0, "ends_turn": false, "utt": 0}, {"kind": "final", "text": "a pena de morte.", "t_start": 32.66, "t_end": 33.4, "t_avail": 34.2, "ends_turn": true, "utt": 8}, {"kind": "partial", "text": "Talvez isso", "t_start": 34.2, "t_end": 34.88, "t_avail": 35.6, "ends_turn": false, "utt": 9}, {"kind": "partial", "text": "seja um argumento", "t_start": 34.900000000000006, "t_end": 35.660000000000004, "t_avail": 36.2, "ends_turn": false, "utt": 9}, {"kind": "partial", "text": "para", "t_start": 35.660000000000004, "t_end": 35.86, "t_avail": 36.800000000000004, "ends_turn": false, "utt": 9}, {"kind": "final", "text": "o Indomônia.", "t_start": 35.86, "t_end": 36.46, "t_avail": 37.0, "ends_turn": true, "utt": 9}, {"kind": "silence", "text": "<|no voice|>", "t_start": 37.6, "t_end": 37.6, "t_avail": 37.6, "ends_turn": false, "utt": 0}, {"kind": "final", "text": "", "t_start": 37.800000000000004, "t_end": 37.800000000000004, "t_avail": 37.800000000000004, "ends_turn": true, "utt": 10}, {"kind": "silence", "text": "<|no voice|>", "t_start": 38.400000000000006, "t_end": 38.400000000000006, "t_avail": 38.400000000000006, "ends_turn": false, "utt": 0}, {"kind": "final", "text": "Filho da...", "t_start": 38.17, "t_end": 39.57000000000001, "t_avail": 40.0, "ends_turn": true, "utt": 11}, {"kind": "partial", "text": "que", "t_start": 40.0, "t_end": 40.2, "t_avail": 41.2, "ends_turn": false, "utt": 12}, {"kind": "partial", "text": "reformar a pena de", "t_start": 40.2, "t_end": 41.18, "t_avail": 41.800000000000004, "ends_turn": false, "utt": 12}, {"kind": "partial", "text": "morte", "t_start": 41.2, "t_end": 41.48, "t_avail": 42.400000000000006, "ends_turn": false, "utt": 12}, {"kind": "final", "text": "como ela é picada.", "t_start": 41.6, "t_end": 42.72, "t_avail": 43.2, "ends_turn": true, "utt": 12}, {"kind": "partial", "text": "Não", "t_start": 43.2, "t_end": 43.78, "t_avail": 44.400000000000006, "ends_turn": false, "utt": 13}, {"kind": "silence", "text": "<|no voice|>", "t_start": 44.800000000000004, "t_end": 44.800000000000004, "t_avail": 44.800000000000004, "ends_turn": false, "utt": 0}, {"kind": "final", "text": "Não abo... É.", "t_start": 43.7, "t_end": 44.18, "t_avail": 45.0, "ends_turn": true, "utt": 13}, {"kind": "silence", "text": "<|no voice|>", "t_start": 46.2, "t_end": 46.2, "t_avail": 46.2, "ends_turn": false, "utt": 0}, {"kind": "final", "text": "", "t_start": 46.400000000000006, "t_end": 46.400000000000006, "t_avail": 46.400000000000006, "ends_turn": true, "utt": 14}, {"kind": "silence", "text": "<|no voice|>", "t_start": 47.400000000000006, "t_end": 47.400000000000006, "t_avail": 47.400000000000006, "ends_turn": false, "utt": 0}, {"kind": "final", "text": "para o Estado.", "t_start": 46.400000000000006, "t_end": 47.02, "t_avail": 47.6, "ends_turn": true, "utt": 15}, {"kind": "partial", "text": "mata alguém", "t_start": 47.6, "t_end": 48.02, "t_avail": 48.800000000000004, "ends_turn": false, "utt": 16}, {"kind": "partial", "text": "baseado em crimes porque seria", "t_start": 48.04, "t_end": 49.36, "t_avail": 50.2, "ends_turn": false, "utt": 16}, {"kind": "partial", "text": "ridículo se", "t_start": 49.38, "t_end": 50.14, "t_avail": 50.800000000000004, "ends_turn": false, "utt": 16}, {"kind": "final", "text": "tipo um...", "t_start": 50.160000000000004, "t_end": 51.04, "t_avail": 51.2, "ends_turn": true, "utt": 16}, {"kind": "final", "text": "Obrigado. Pessoas...", "t_start": 51.2, "t_end": 52.18, "t_avail": 52.2, "ends_turn": true, "utt": 17}, {"kind": "partial", "text": "que é preta quando você não pode", "t_start": 52.2, "t_end": 53.88, "t_avail": 54.800000000000004, "ends_turn": false, "utt": 18}, {"kind": "partial", "text": "me", "t_start": 53.88, "t_end": 54.080000000000005, "t_avail": 54.800000000000004, "ends_turn": false, "utt": 18}, {"kind": "partial", "text": "matar. Sou preto", "t_start": 54.080000000000005, "t_end": 54.88, "t_avail": 55.400000000000006, "ends_turn": false, "utt": 18}, {"kind": "silence", "text": "<|no voice|>", "t_start": 56.0, "t_end": 56.0, "t_avail": 56.0, "ends_turn": false, "utt": 0}, {"kind": "final", "text": "Eu sou preto e eu sou legal.", "t_start": 54.52, "t_end": 55.480000000000004, "t_avail": 56.2, "ends_turn": true, "utt": 18}, {"kind": "partial", "text": "Pesquisas", "t_start": 56.31, "t_end": 56.970000000000006, "t_avail": 58.800000000000004, "ends_turn": false, "utt": 19}, {"kind": "final", "text": "são desproporcionalmente aplicadas a pena de morte,", "t_start": 56.870000000000005, "t_end": 58.45, "t_avail": 60.0, "ends_turn": false, "utt": 19}, {"kind": "final", "text": "você sabe isso e...", "t_start": 58.870000000000005, "t_end": 59.970000000000006, "t_avail": 60.0, "ends_turn": true, "utt": 19}, {"kind": "partial", "text": "tipo, não", "t_start": 60.0, "t_end": 60.68, "t_avail": 61.2, "ends_turn": false, "utt": 20}, {"kind": "silence", "text": "<|no voice|>", "t_start": 61.400000000000006, "t_end": 61.400000000000006, "t_avail": 61.400000000000006, "ends_turn": false, "utt": 0}, {"kind": "final", "text": "eu trago.", "t_start": 60.68, "t_end": 61.18, "t_avail": 61.6, "ends_turn": true, "utt": 20}, {"kind": "silence", "text": "<|no voice|>", "t_start": 62.2, "t_end": 62.2, "t_avail": 62.2, "ends_turn": false, "utt": 0}, {"kind": "silence", "text": "<|no voice|>", "t_start": 63.2, "t_end": 63.2, "t_avail": 63.2, "ends_turn": false, "utt": 0}, {"kind": "final", "text": "Da mesma forma.", "t_start": 61.940000000000005, "t_end": 62.92, "t_avail": 63.400000000000006, "ends_turn": true, "utt": 21}, {"kind": "silence", "text": "<|no voice|>", "t_start": 64.60000000000001, "t_end": 64.60000000000001, "t_avail": 64.60000000000001, "ends_turn": false, "utt": 0}, {"kind": "final", "text": "Tentimento", "t_start": 63.400000000000006, "t_end": 64.10000000000001, "t_avail": 65.0, "ends_turn": true, "utt": 22}, {"kind": "silence", "text": "<|no voice|>", "t_start": 65.8, "t_end": 65.8, "t_avail": 65.8, "ends_turn": false, "utt": 0}, {"kind": "final", "text": "que não dou.", "t_start": 65.0, "t_end": 65.44, "t_avail": 66.2, "ends_turn": true, "utt": 23}, {"kind": "partial", "text": "Como ele se", "t_start": 66.2, "t_end": 67.06, "t_avail": 67.60000000000001, "ends_turn": false, "utt": 24}, {"kind": "partial", "text": "encaixa no argumento", "t_start": 67.06, "t_end": 67.82000000000001, "t_avail": 68.4, "ends_turn": false, "utt": 24}, {"kind": "partial", "text": "da pena de morte?", "t_start": 67.8, "t_end": 68.42, "t_avail": 69.2, "ends_turn": false, "utt": 24}, {"kind": "silence", "text": "<|no voice|>", "t_start": 69.60000000000001, "t_end": 69.60000000000001, "t_avail": 69.60000000000001, "ends_turn": false, "utt": 0}, {"kind": "final", "text": "", "t_start": 70.0, "t_end": 70.0, "t_avail": 70.0, "ends_turn": true, "utt": 24}, {"kind": "silence", "text": "<|no voice|>", "t_start": 70.60000000000001, "t_end": 70.60000000000001, "t_avail": 70.60000000000001, "ends_turn": false, "utt": 0}, {"kind": "silence", "text": "<|no voice|>", "t_start": 71.2, "t_end": 71.2, "t_avail": 71.2, "ends_turn": false, "utt": 0}], "user_speech_spans": [[2.2, 6.1], [6.4, 9.2], [10.1, 12.5], [14.9, 15.6], [15.7, 16.3], [16.7, 17.0], [17.2, 18.9], [19.2, 24.1], [24.3, 24.8], [25.3, 25.7], [26.9, 30.3], [30.5, 33.5], [34.3, 36.4], [36.5, 37.1], [38.5, 39.3], [39.8, 42.5], [42.9, 44.3], [45.2, 45.7], [46.4, 47.0], [47.6, 50.6], [51.0, 51.6], [51.8, 55.6], [56.7, 59.3], [59.5, 60.4], [60.5, 61.0], [62.3, 62.8], [63.6, 64.2], [65.0, 65.4], [66.5, 68.5], [68.7, 69.2]], "decisions": [{"kind": "partial", "t": 3.2, "piece": "para", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.429}, {"kind": "partial", "t": 4.4, "piece": "receber a pena de", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.376}, {"kind": "partial", "t": 5.2, "piece": "morte, mas se você", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.335}, {"kind": "partial", "t": 5.8, "piece": "pensar bem,", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.406}, {"kind": "partial", "t": 6.6, "piece": "se basear", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.367}, {"kind": "final", "t": 6.8, "piece": "qualquer.", "ends_turn": true, "tag": "user_finish_speaking", "text": "É um direito básico, sim. O Código de Defesa do Consumidor garante isso, e é fundamental para que o consumidor consiga um serviço de qualidade.", "compute_s": 4.053}, {"kind": "partial", "t": 9.0, "piece": "decisão moral no que as outras", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.339}, {"kind": "silence", "t": 9.6, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.36}, {"kind": "partial", "t": 9.6, "piece": "pessoas sentem.", "ends_turn": false, "tag": "user_finish_speaking", "text": "Nisso eu entendo perfeitamente. Às vezes, a pressão social é enorme, e é preciso ter a força para manter a firmeza. É um processo de superação constante.", "compute_s": 4.025}, {"kind": "final", "t": 9.8, "piece": "", "ends_turn": true, "tag": "user_is_thinking", "text": "", "compute_s": 0.297}, {"kind": "silence", "t": 13.0, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_thinking", "text": "", "compute_s": 0.252}, {"kind": "partial", "t": 13.0, "piece": "Mas é", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.248}, {"kind": "final", "t": 13.2, "piece": "ada em sentimentos de vingança, então você", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.395}, {"kind": "final", "t": 13.2, "piece": "não vai ter um bom bobum.", "ends_turn": true, "tag": "user_finish_speaking", "text": "Exatamente. É crucial que a reação seja proporcional e focada em resolver o problema, e não em causar mais dor. Isso ajuda a manter a paz.", "compute_s": 3.377}, {"kind": "silence", "t": 13.8, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_thinking", "text": "", "compute_s": 0.173}, {"kind": "silence", "t": 14.4, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_thinking", "text": "", "compute_s": 0.347}, {"kind": "partial", "t": 16.2, "piece": "sistema moral.", "ends_turn": false, "tag": "user_finish_speaking", "text": "É um desafio, mas com planejamento, você consegue gerenciar bem essas situações. Lembre-se que a calma é sempre a melhor tática.", "compute_s": 3.331}, {"kind": "partial", "t": 16.8, "piece": "O legal de", "ends_turn": false, "tag": "user_interruption", "text": "", "compute_s": 0.292}, {"kind": "partial", "t": 17.4, "piece": "justi...", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.374}, {"kind": "final", "t": 17.6, "piece": "É! E aqui tá...", "ends_turn": true, "tag": "user_finish_speaking", "text": "É um direito seu, e você tem todo o direito de exigir isso. Não hesite em buscar ajuda jurídica se o caso for muito sério.", "compute_s": 2.794}, {"kind": "final", "t": 19.6, "piece": "Outro argumento que eu vou dizer, a", "ends_turn": false, "tag": "user_interruption", "text": "", "compute_s": 0.261}, {"kind": "final", "t": 19.6, "piece": "justiça...", "ends_turn": true, "tag": "user_finish_speaking", "text": "A justiça é um processo, não um evento único. Ela envolve muita paciência e consistência, especialmente quando você está lutando por algo grande.", "compute_s": 2.817}, {"kind": "partial", "t": 22.2, "piece": "não é distribuída igualmente.", "ends_turn": false, "tag": "user_finish_speaking", "text": "É verdade. Às vezes, as instituições precisam de mais tempo para anal isar, o que pode esticar o período da sua insatisfação. É importante ter paciência nesse c", "compute_s": 4.064}, {"kind": "partial", "t": 25.0, "piece": "É a adição muito mais proporcionalmente do", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.238}, {"kind": "partial", "t": 25.0, "piece": "mundo.", "ends_turn": false, "tag": "user_finish_speaking", "text": "Com certeza. O mundo é complexo, e as leis buscam equilibrar isso. É sempre bom verificar os limites legais antes de tomar qualquer atitude drástica.", "compute_s": 3.709}, {"kind": "silence", "t": 25.2, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_thinking", "text": "", "compute_s": 0.179}, {"kind": "final", "t": 25.4, "piece": "", "ends_turn": true, "tag": "user_is_speaking", "text": "", "compute_s": 0.382}, {"kind": "silence", "t": 26.2, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.389}, {"kind": "final", "t": 26.4, "piece": "PEN -", "ends_turn": true, "tag": "user_is_speaking", "text": "", "compute_s": 0.325}, {"kind": "partial", "t": 28.6, "piece": "Outras pessoas brancas que", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.385}, {"kind": "partial", "t": 29.2, "piece": "cometeram os", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.388}, {"kind": "partial", "t": 30.0, "piece": "mesmos crimes em", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.337}, {"kind": "partial", "t": 30.6, "piece": "múltiplos", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.277}, {"kind": "final", "t": 31.0, "piece": "estados. Mas isso não é verdade.", "ends_turn": true, "tag": "user_finish_speaking", "text": "Não é verdade. O Código de Defesa do Consumidor é um direito garantido, e não depende de \"quem mais fez\". Você pode buscar orientação em órgãos de defesa do con", "compute_s": 3.799}, {"kind": "partial", "t": 32.2, "piece": "significa", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.238}, {"kind": "partial", "t": 32.8, "piece": "que devamos", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.263}, {"kind": "partial", "t": 33.6, "piece": "ou não ter", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.315}, {"kind": "silence", "t": 34.0, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.365}, {"kind": "final", "t": 34.2, "piece": "a pena de morte.", "ends_turn": true, "tag": "user_finish_speaking", "text": "É um direito que deve ser respeitado, sim. Mas também é importante lembrar que o direito de defesa é um direito do acusado, não do promotor.", "compute_s": 2.877}, {"kind": "partial", "t": 35.6, "piece": "Talvez isso", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.208}, {"kind": "partial", "t": 36.2, "piece": "seja um argumento", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.189}, {"kind": "partial", "t": 36.8, "piece": "para", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.262}, {"kind": "final", "t": 37.0, "piece": "o Indomônia.", "ends_turn": true, "tag": "user_finish_speaking", "text": "Pode ser um ponto de partida, mas o foco principal deve ser a proposta de resolução do problema. O segredo é sempre buscar um acordo primeiro.", "compute_s": 3.281}, {"kind": "silence", "t": 37.6, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_thinking", "text": "", "compute_s": 1.737}, {"kind": "final", "t": 37.8, "piece": "", "ends_turn": true, "tag": "user_is_speaking", "text": "", "compute_s": 1.567}, {"kind": "silence", "t": 38.4, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 1.74}, {"kind": "final", "t": 40.0, "piece": "Filho da...", "ends_turn": true, "tag": "user_is_speaking", "text": "", "compute_s": 1.439}, {"kind": "partial", "t": 41.2, "piece": "que", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 1.588}, {"kind": "partial", "t": 41.8, "piece": "reformar a pena de", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 1.6}, {"kind": "partial", "t": 42.4, "piece": "morte", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 1.763}, {"kind": "final", "t": 43.2, "piece": "como ela é picada.", "ends_turn": true, "tag": "user_finish_speaking", "text": "Essa é uma proposta muito radical, e ela exige muita discussão política. É um tema que envolve muita complexidade social e legal.", "compute_s": 3.731}, {"kind": "partial", "t": 44.4, "piece": "Não", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 1.616}, {"kind": "silence", "t": 44.8, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 1.643}, {"kind": "final", "t": 45.0, "piece": "Não abo... É.", "ends_turn": true, "tag": "user_finish_speaking", "text": "É um tema que exige muita reflexão profunda, porque ele muda o conceito de culpa e de recompensa.", "compute_s": 2.47}, {"kind": "silence", "t": 46.2, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_thinking", "text": "", "compute_s": 1.596}, {"kind": "final", "t": 46.4, "piece": "", "ends_turn": true, "tag": "user_is_speaking", "text": "", "compute_s": 1.449}, {"kind": "silence", "t": 47.4, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 1.52}, {"kind": "final", "t": 47.6, "piece": "para o Estado.", "ends_turn": true, "tag": "user_finish_speaking", "text": "Exatamente. O que o mundo espera do governo é que ele resolva essas questões complexas de forma justa e sustentável para todos.", "compute_s": 4.19}, {"kind": "partial", "t": 48.8, "piece": "mata alguém", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 1.772}, {"kind": "partial", "t": 50.2, "piece": "baseado em crimes porque seria", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 1.628}, {"kind": "partial", "t": 50.8, "piece": "ridículo se", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 1.674}, {"kind": "final", "t": 51.2, "piece": "tipo um...", "ends_turn": true, "tag": "user_finish_speaking", "text": "É um debate eterno, e não tem resposta única. O importante é que, em qualquer sistema, existe um limite de proporcionalidade que deve ser respeitado.", "compute_s": 0.491}, {"kind": "final", "t": 52.2, "piece": "Obrigado. Pessoas...", "ends_turn": true, "tag": "user_finish_speaking", "text": "De nada! Se precisar de mais alguma coisa, é só chamar. Estou aqui para ajudar no que for preciso.", "compute_s": 0.62}, {"kind": "partial", "t": 54.8, "piece": "que é preta quando você não pode", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.465}, {"kind": "partial", "t": 54.8, "piece": "me", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.675}, {"kind": "partial", "t": 55.4, "piece": "matar. Sou preto", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.231}, {"kind": "silence", "t": 56.0, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.321}, {"kind": "final", "t": 56.2, "piece": "Eu sou preto e eu sou legal.", "ends_turn": true, "tag": "user_finish_speaking", "text": "Entendo perfeitamente essa sensação de desigualdade. É um desafio social enorme, e a gente precisa de mais conversas assim.", "compute_s": 0.579}, {"kind": "partial", "t": 58.8, "piece": "Pesquisas", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.229}, {"kind": "final", "t": 60.0, "piece": "são desproporcionalmente aplicadas a pena de morte,", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.318}, {"kind": "final", "t": 60.0, "piece": "você sabe isso e...", "ends_turn": true, "tag": "user_finish_speaking", "text": "Sim, é um ponto crucial. O sistema tem um histórico de aplicar a pena de mort e mais frequentemente em grupos mais vulneráveis, o que ger a muita insatisfação.", "compute_s": 0.644}, {"kind": "partial", "t": 61.2, "piece": "tipo, não", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.36}, {"kind": "silence", "t": 61.4, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.318}, {"kind": "final", "t": 61.6, "piece": "eu trago.", "ends_turn": true, "tag": "user_finish_speaking", "text": "É um debate constante, e a gente precisa de mais dados para entender a dimensão do problema.", "compute_s": 0.488}, {"kind": "silence", "t": 62.2, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_thinking", "text": "", "compute_s": 0.305}, {"kind": "silence", "t": 63.2, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_thinking", "text": "", "compute_s": 0.356}, {"kind": "final", "t": 63.4, "piece": "Da mesma forma.", "ends_turn": true, "tag": "user_finish_speaking", "text": "Com certeza.", "compute_s": 0.516}, {"kind": "silence", "t": 64.6, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_thinking", "text": "", "compute_s": 0.488}, {"kind": "final", "t": 65.0, "piece": "Tentimento", "ends_turn": true, "tag": "user_is_speaking", "text": "", "compute_s": 0.207}, {"kind": "silence", "t": 65.8, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.324}, {"kind": "final", "t": 66.2, "piece": "que não dou.", "ends_turn": true, "tag": "user_finish_speaking", "text": "É um sentimento muito forte, e é super válido . É um direito que deve ser protegido de qualquer forma possível.", "compute_s": 0.696}, {"kind": "partial", "t": 67.6, "piece": "Como ele se", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.326}, {"kind": "partial", "t": 68.4, "piece": "encaixa no argumento", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.169}, {"kind": "partial", "t": 69.2, "piece": "da pena de morte?", "ends_turn": false, "tag": "user_finish_speaking", "text": "Ele se encaixa porque a própria proposta de manter a pena de mort e pode ser um ato de desrespeito ao direito à vida do acusado.", "compute_s": 2.413}, {"kind": "silence", "t": 69.6, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_thinking", "text": "", "compute_s": 0.442}, {"kind": "final", "t": 70.0, "piece": "", "ends_turn": true, "tag": "user_is_speaking", "text": "", "compute_s": 0.395}, {"kind": "silence", "t": 70.6, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.296}, {"kind": "silence", "t": 71.2, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.293}], "render": {"placed_speech_s": 48.844, "placed_within_input_s": 46.204, "speech_beyond_input_s": 2.64, "clipped_speech_s": 0.0, "tail_s": 4.0, "turns": 22}}