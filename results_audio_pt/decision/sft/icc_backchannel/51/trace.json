": 0.024}, {"kind": "final", "t": 50.4, "piece": "quando você não pode me matar Tô", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.023}, {"kind": "final", "t": 50.4, "piece": "preto e eu...", "ends_turn": true, "tag": "user_finish_speaking", "text": "É um ponto forte. O limite moral é sempre o mais difícil de estabelecer.", "compute_s": 0.18}, {"kind": "silence", "t": 51.6, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_thinking", "text": "", "compute_s": 0.026}, {"kind": "final", "t": 51.8, "piece": "Muito bem -vindo.", "ends_turn": true, "tag": "user_finish_speaking", "text": "Valeu!", "compute_s": 0.074}, {"kind": "partial", "t": 53.2, "piece": "são", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.024}, {"kind": "partial", "t": 53.8, "piece": "desproporcionalmente", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.024}, {"kind": "partial", "t": 54.4, "piece": "aplicados", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.024}, {"kind": "partial", "t": 55.2, "piece": "a pena de morte,", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.025}, {"kind": "final", "t": 55.6, "piece": "você sabe que isso...", "ends_turn": true, "tag": "user_finish_speaking", "text": "Sim, é um problema sério de desigualdade.", "compute_s": 0.337}, {"kind": "partial", "t": 57.4, "piece": "Isso é tipo... Não é", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.136}, {"kind": "final", "t": 57.6, "piece": "na mesma...", "ends_turn": true, "tag": "user_is_speaking", "text": "", "compute_s": 0.241}, {"kind": "final", "t": 59.4, "piece": "fomentos de vingança.", "ends_turn": true, "tag": "user_finish_speaking", "text": "Exatamente. É um ciclo vicioso.", "compute_s": 0.329}, {"kind": "silence", "t": 60.6, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_thinking", "text": "", "compute_s": 0.264}, {"kind": "final", "t":