speaking", "text": "", "compute_s": 0.069}, {"kind": "final", "t": 25.2, "piece": "médico.", "ends_turn": true, "tag": "user_finish_speaking", "text": "Tá, entendi. Se ela está com dores, confusão ou sintomas estranhos, sim, é importante ir ao médico. Vou avisar com cuidado. 😊<|im_end|>", "compute_s": 1.539}, {"kind": "silence", "t": 25.8, "piece": "<|no voice|>", "ends_turn": false, "tag": "user_is_speaking", "text": "", "compute_s": 0.141}], "render": {"placed_speech_s": 12.24, "placed_within_input_s": 9.28, "speech_beyond_input_s": 2.96, "clipped_speech_s": 0.0, "tail_s": 4.0, "turns": 5}}