eaking:empty", "user_is_speaking:empty", "user_finish_speaking", "user_is_speaking:empty", "user_is_speaking:empty", "user_finish_speaking", "user_is_speaking:empty", "user_is_speaking:empty", "user_finish_speaking", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty", "user_finish_speaking", "no_tag:empty", "user_interruption:empty", "user_is_speaking:empty", "user_finish_speaking", "user_is_speaking:empty", "user_is_speaking:empty", "user_is_speaking:empty"], "turns": [{"start": 17.32, "end": 17.757, "natural_end": 17.8, "dur": 0.437, "text": "Tchau! 😊<|im_end|>", "tag": "user_finish_speaking", "kind": "speech", "n_words": 2, "stopped": true}, {"start": 19.975, "end": 19.975, "natural_end": 33.015, "dur": 0.0, "text": "Tá, foi um choque, né? Crescer com isso é realmente impactante. 😊<|im_end|>", "tag": "user_finish_speaking", "kind": "speech", "n_words": 12, "stopped": true}, {"start": 23.471, "end": 23.8, "natural_end": 34.511, "dur": 0.329, "text": "Que legal! Amor é o melhor choque de todos. 💖<|im_end|>", "tag": "user_finish_speaking", "kind": "speech", "n_words": 10, "stopped": true}, {"start": 24.8, "end": 24.8, "natural_end": 26.72, "dur": 0.0, "text": "Tchau! 😊<|im_end|>", "tag": "user_finish_speaking", "kind": "speech", "n_words": 2, "stopped": true}, {"start": 28.868, "end": 29.06, "natural_end": 40.228, "dur": 0.192, "text": "Tá, e você era o buraco da bolha... 😄<|im_end|>", "tag": "user_finish_speaking", "kind": "speech", "n_words": 9, "stopped": true}, {"start": 35.295, "end": 35.295, "natural_end": 35.615, "dur": 0.0, "text": "Ah, América real, né? Que legal ter vivido isso! 🌍✨<|im_end|>", "tag": "user_finish_speaking", "kind": "speech", "n_words": 10, "stopped": true}, {"start": 41.738, "end": 43.864, "natural_end": 56.138, "dur": 2.126, "text": "Certo, você foi o olho do vento — e agora vê tudo com mais clareza. 💫<|im_end|>", "tag": "user_finish_speaking", "kind": "speech", "n_words": 16, "stopped": true}, {"start": 45.26, "end": 47.659, "natural_end": 59.9, "dur": 2.399, "text": "Sim, mudanças assim transformam a gente. Você tá com a visão mais aberta agora, e isso é poderoso. 🌟<|im_end|>", "tag": "user_finish_speaking", "kind": "speech", "n_words": 19, "stopped": true}, {"start": 54.289, "end": 54.289, "natural_end": 68.689, "dur": 0.0, "text": "Tá, um estado liberal com diversidade? Que lugar legal de se sentir em casa! 🌈✨<|im_end|>", "tag": "user_finish_speaking", "kind": "speech", "n_words": 15, "stopped": true}, {"start": 62.952, "end": 65.053, "natural_end": 78.072, "dur": 2.101, "text": "Certo, você viu a diferença — e isso é o que importa. O mundo é maior do que parece. 🌍💡<|im_end|>", "tag": "user_finish_speaking", "kind": "speech", "n_words": 20, "stopped": true}, {"start": 65.453, "end": 81.133, "natural_end": 81.133, "dur": 15.68, "text": "Sim, e isso mostra quanto a diversidade é rica e diferente em cada lugar. Cada bairro tem sua história. 🏙️❤️<|im_end|>", "tag": "user_finish_speaking", "kind": "speech", "n_words": 20, "stopped": false}, {"start": 81.133, "end": 81.133, "natural_end": 82.653, "dur": 0.0, "text": "Tá, você percebeu a extensão", "tag": "user_finish_speaking", "kind": "speech", "n_words": 5, "stopped": true}, {"start": 76.227, "end": 76.227, "natural_end": 82.627, "dur": 0.0, "text": "Isso é realmente impactante. Quando falamos de escolas de internato caras, como 30 ou 40 mil reais por ano no ensino", "tag": "user_finish_speaking", "kind": "speech", "n_words": 21, "stopped": true}, {"start": 78.336, "end": 82.416, "natural_end": 82.416, "dur": 4.08, "text": "Tá, é só um tom diferente — mas pode ser muito forte. Um jeito", "tag": "user_finish_speaking", "kind": "speech", "n_words": 14, "stopped": false}], "user_pieces": [{"kind": "final", "text": "E, com certeza,", "t_start": 1.71, "t_end": 2.71, "t_avail": 3.2, "ends_turn": true, 