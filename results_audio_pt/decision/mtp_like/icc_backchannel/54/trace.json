.", "t_start": 15.4, "t_end": 15.620000000000001, "t_avail": 16.400000000000002, "ends_turn": true, "utt": 4}, {"kind": "partial", "text": "Foi um choque tão", "t_start": 16.400000000000002, "t_end": 17.180000000000003, "t_avail": 17.8, "ends_turn": false, "utt": 5}, {"kind": "final", "text": "grande, eu sempre eu cresci...", "t_start": 17.220000000000002, "t_end": 18.380000000000003, "t_avail": 18.400000000000002, "ends_turn": true, "utt": 5}, {"kind": "final", "text": "e assim. Eu sempre...", "t_start": 18.400000000000002, "t_end": 19.380000000000003, "t_avail": 19.400000000000002, "ends_turn": true, "utt": 6}, {"kind": "silence", "text": "<|no voice|>", "t_start": 20.6, "t_end": 20.6, "t_avail": 20.6, "ends_turn": false, "utt": 0}, {"kind": "final", "text": "que a gente, tipo...", "t_start": 19.400000000000002, "t_end": 20.3, "t_avail": 20.8, "ends_turn": true, "utt": 7}, {"kind": "silence", "text": "<|no voice|>", "t_start": 21.400000000000002, "t_end": 21.400000000000002, "t_avail": 21.400000000000002, "ends_turn": false, "utt": 0}, {"kind": "silence", "text": "<|no voice|>", "t_start": 22.400000000000002, "t_end": 22.400000000000002, "t_avail": 22.400000000000002, "ends_turn": false, "utt": 0}, {"kind": "final", "text": "Amo!", "t_start": 21.2, "t_end": 22.0, "t_avail": 22.6, "ends_turn": true, "utt": 8}, {"kind": "silence", "text": "<|no voice|>", "t_start": 23.8, "t_end": 23.8, "t_avail": 23.8, "ends_turn": false, "utt": 0}, {"kind": "final", "text": "Tchau.", "t_start": 22.62, "t_end": 23.240000000000002, "t_avail": 24.0, "ends_turn": true, "utt": 9}, {"kind": "partial", "text": "Era tipo o resto do", "t_start": 24.05, "t_end": 25.25, "t_avail": 26.0, "ends_turn": false, "utt": 10}, {"kind": "partial", "text": "país tava", "t_start": 25.27, "t_end": 25.67, "t_avail": 26.6, "ends_turn": false, "utt": 10}, {"kind": "final", "text": "numa bolha e eu era tipo...", "t_start": 25.65, "t_end": 27.17, "t_avail": 27.200000000000003, "ends_turn": true, "utt": 10}, {"